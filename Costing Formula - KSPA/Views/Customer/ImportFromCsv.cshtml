@model List<Costing_Formula___KSPA.Models.ViewModels.CustomerVM>

@{
    ViewData["Title"] = "Customer Master - Import CSV";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Customer Master - Import CSV</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Create"><i class="fa-regular fa-circle-plus"></i> Add New</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <label for="formFile" class="form-label">Please choose the csv file to import from...</label>&nbsp;<label>(<a href="@Url.Content("~/import-templates/Customers.csv")">Click here to download the import template.</a>)</label>
    </div>
    <div class="col-sm-8">
        <div class="mb-3">
            <input class="form-control" type="file" id="upload_file" accept=".csv">
        </div>
    </div>
    <div class="col-sm-4">
        <div class="mb-3 d-grid gap-2">
            <button class="btn btn-primary" id="process_button"><i class="fa-regular fa-gears"></i> <b>Process</b></button>
        </div>
    </div>
    <div class="col-12">
        <hr class="bg-primary border-2 border-primary" />
    </div>
</div>

<div class="row">
    <form method="post" asp-action="ImportFromCsv">

        <div class="col-md-12">
            <!-- Card -->
            <div class="card mb-3 shadow-sm border-primary text-white bg-dark">
                <div class="card-header text-bg-primary border-primary bg-primary align-middle">
                    <lable class="fw-bold">Proceed CSV...</lable>&nbsp;<lable>(<a>Click here to download the import template...</a>)</lable>
                </div>
                <div class="card-body text-white">
                    <blockquote class="row">
                        <table class="data-table table text-white" style="min-width: 98%">
                            <thead>
                                <tr>
                                    <th class="text-nowrap" scope="col">Customer Short Code</th>
                                    <th class="text-nowrap" scope="col">Customer Type</th>
                                    <th class="text-nowrap" scope="col">Currency</th>
                                    <th class="text-nowrap" scope="col">Customer Name</th>
                                    <th class="text-nowrap" scope="col">Company</th>
                                    <th class="text-nowrap" scope="col">Email</th>
                                    <th class="text-nowrap" scope="col">Address</th>
                                    <th class="text-nowrap" scope="col">Sales Rep Short Name</th>
                                    <th class="text-nowrap" scope="col">Sales Coordinator Short Name</th>
                                    <th class="text-nowrap" scope="col">Active&quest;</th>
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                <tr>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].Customer.CustomerShortCode" readonly>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.CustomerShortCode"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].Customer.CustomerTypeId" asp-items="@Model[0].CustomerTypeDropDown" readonly></select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.CustomerTypeId"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].Customer.CurrencyId" asp-items="@Model[0].CurrencyDropDown" readonly></select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.CurrencyId"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].Customer.CustomerName" placeholder="Customer name here" readonly>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.CustomerName"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].Customer.CompanyId" asp-items="@Model[0].CompanyDropDown" readonly>
                                            <option selected>-- select company --</option>
                                        </select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.CompanyId"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].Customer.Email" placeholder="Customer email" readonly>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.Email"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].Customer.CustomerAddress" readonly>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.CustomerAddress"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].Customer.SRepId" asp-items="@Model[0].SRepDropDown"></select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.SRepId"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].Customer.SCoordinatorId" asp-items="@Model[0].SCoordinatorDropDown"></select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.SCoordinatorId"></span></b>
                                    </td>
                                    <td>
                                        <input class="form-check-input" asp-for="@Model[0].Customer.IsActive" readonly>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].Customer.IsActive"></span></b>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </blockquote>
                </div>
            </div> <!-- End of the card -->
        </div>
        <div class="col-12">
            <div class="d-grid gap-2">
                <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
            </div>
        </div>

    </form>
</div>

@section Scripts{
    <script src="~/lib/papaparse/dist/papaparse.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            document.getElementById('table-body').innerHTML = '';
        });

        const process_btn = document.getElementById('process_button')
            .addEventListener('click', () => {
                Papa.parse(document.getElementById('upload_file').files[0], {
                    download: true,
                    header: true,
                    skipEmptyLines: true,
                    complete: function (results) {
                        document.getElementById('table-body').innerHTML = '';
                        add_input_rows(results.data);
                    }
                });
            });

        function add_input_rows(customers) {
            var html_string = '';
            for (var i = 0; i < customers.length; i++) {

                var customer = customers[i];

                var row_count = document.getElementById('table-body').childElementCount + i;
                if (typeof customer.Code === 'undefined') {
                    alert('\"Code\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Type === 'undefined') {
                    alert('\"Type\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Currency === 'undefined') {
                    alert('\"Currency\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Name === 'undefined') {
                    alert('\"Name\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Company === 'undefined') {
                    alert('\"Company\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Email === 'undefined') {
                    alert('\"Email\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                } else if(customer.Email === null) {
                    customer.Email = '';
                }
                if (typeof customer.Address === 'undefined') {
                    alert('\"Address\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                } else if (customer.Address === null) {
                    customer.Address = '';
                }
                if (typeof customer.Rep === 'undefined') {
                    alert('\"Rep\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Coordinator === 'undefined') {
                    alert('\"Coordinator\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof customer.Active === 'undefined') {
                    alert('\"Active\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                var is_checked;
                if (customer.Active.toLowerCase() == 'true' || customer.Active == '1') {
                    is_checked = 'checked';
                } else if (customer.Active.toLowerCase() == 'false' || customer.Active == '0') {
                    is_checked = '';
                } else {
                    alert(customer.Active + ' is not valid value for the column \"Active\"! Please correct and process again');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var customer_type_id;
                var customer_type_obj = get_object_by_text(@Html.Raw(ViewBag.CustomerTypeJsonStr), customer.Type);
                if (customer_type_obj == null) {
                    customer_type_id = null;
                } else {
                    customer_type_id = customer_type_obj.Id;
                }
                if (customer_type_id === null) {
                    alert(customer.Type + " is not available inside the customer type master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var customer_currency_id;
                var customer_currency_obj = get_object_by_text(@Html.Raw(ViewBag.CurrencyJsonStr), customer.Currency);
                if (customer_currency_obj == null) {
                    customer_currency_id = null;
                } else {
                    customer_currency_id = customer_currency_obj.Id;
                }
                if (customer_currency_id === null) {
                    alert(customer.Currency + " currency code is not available inside the currency master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var company_id;
                var company_obj = get_object_by_text(@Html.Raw(ViewBag.CompanyJsonStr), customer.Company);
                if (company_obj == null) {
                    company_id = null;
                } else {
                    company_id = company_obj.Id;
                }
                if (company_id === null) {
                    alert(customer.Company + " company is not available inside the company master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var sales_rep_id;
                var sales_rep_obj = get_object_by_text(@Html.Raw(ViewBag.SalesRepJsonStr), customer.Rep);
                if (sales_rep_obj == null) {
                    sales_rep_id = null
                } else {
                    sales_rep_id = sales_rep_obj.Id;
                }
                if (sales_rep_id === null) {
                    alert(customer.Rep + " is not a sales rep inside the sales rep / coordinator master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var sales_coord_id;
                var sales_coord_obj = get_object_by_text(@Html.Raw(ViewBag.SalesCoordJsonStr), customer.Coordinator);
                if (sales_coord_obj == null) {
                    sales_coord_id = null;
                } else {
                    sales_coord_id = sales_coord_obj.Id;
                }
                if (sales_coord_id === null) {
                    alert(customer.Coordinator + " is not a sales coordinator inside the sales rep / coordinator master! First update the master.");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                html_string += 
                    `
                    <tr>
                        <td>
                            <input type="text" class="form-control" data-val="true" data-val-required="The CustomerShortCode field is required." id="z`+ row_count + `__Customer_CustomerShortCode" name="[` + row_count + `].Customer.CustomerShortCode" value="`+ customer.Code +`" readonly>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.CustomerShortCode" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <select class="form-select" data-val="true" data-val-required="The CustomerTypeId field is required." id="z`+ row_count + `__Customer_CustomerTypeId" name="[` + row_count + `].Customer.CustomerTypeId" value="` + customer_type_id + `" readonly>
                                <option value="`+ customer_type_id + `" selected>` + customer.Type.toUpperCase() + `</option>
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.CustomerTypeId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <select class="form-select" data-val="true" data-val-required="The CurrencyId field is required." id="z`+ row_count + `__Customer_CurrencyId" name="[` + row_count + `].Customer.CurrencyId" value="` + customer_currency_id + `" readonly>
                                <option value="`+ customer_currency_id + `" selected>` + customer.Currency.toUpperCase() + `</option>
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.CurrencyId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input type="text" class="form-control" placeholder="Customer name here" data-val="true" data-val-required="The CustomerName field is required." id="z`+ row_count + `__Customer_CustomerName" name="[` + row_count + `].Customer.CustomerName" value="` + customer.Name + `" readonly>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.CustomerName" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <select class="form-select" id="z`+ row_count + `__Customer_CompanyId" name="[` + row_count + `].Customer.CompanyId" readonly>
                                <option value="`+ company_id + `" selected>` + customer.Company + `</option>
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].Customer.CompanyId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input type="text" class="form-control" placeholder="Customer email" readonly data-val="true" data-val-required="The Email field is required." id="z`+ row_count + `__Customer_Email" name="[` + row_count + `].Customer.Email" value="`+ customer.Email +`">
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.Email" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input type="text" class="form-control" data-val="true" data-val-required="The CustomerAddress field is required." id="z`+ row_count + `__Customer_CustomerAddress" name="[` + row_count + `].Customer.CustomerAddress" value="` + customer.Address + `" readonly>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.CustomerAddress" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <select class="form-select" data-val="true" data-val-required="The Representative Id field is required." id="z`+ row_count + `__Customer_SRepId" name="[` + row_count + `].Customer.SRepId" value="` + sales_rep_id + `" readonly>
                                <option value="`+ sales_rep_id + `" selected>` + customer.Rep.toUpperCase() + `</option>
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.SRepId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <select class="form-select" data-val="true" data-val-required="The Coordinator Id field is required." id="z`+ row_count + `__Customer_SCoordinatorId" name="[` + row_count + `].Customer.SCoordinatorId" value="` + sales_coord_id + `" readonly>
                                <option value="`+ sales_coord_id + `" selected>` + customer.Coordinator.toUpperCase() + `</option>
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.SCoordinatorId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input class="form-check-input" type="checkbox" data-val="true" data-val-required="The IsActive field is required." id="z`+ row_count + `__Customer_IsActive" name="[` + row_count + `].Customer.IsActive" value="true" ` + is_checked + ` readonly>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].Customer.IsActive" data-valmsg-replace="true"></span></b>
                        </td>
                    </tr>
                    `;

                $("form").removeData("validator").removeData("unobtrusiveValidation");
                //Parse the form again
                $.validator.unobtrusive.parse($("form"));
            }
            $('#table-body').append(html_string);
        }

        function get_object_by_text(json_array, text) {
            for(i=0; i<json_array.length; i++) {
                if (json_array[i].Text.toLowerCase() == text.toLowerCase())
                    return json_array[i];
            }
            return null;
        }

    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
