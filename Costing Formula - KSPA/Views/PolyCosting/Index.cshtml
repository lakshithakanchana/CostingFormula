}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Polythene Quotations - List View</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-primary btn-outline-light border border-2" asp-action="Create"><i class="fa-regular fa-circle-plus"></i> Add New</a>
        </div>
    </div>
</div>

