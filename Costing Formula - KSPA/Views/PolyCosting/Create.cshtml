            // Common Functions........................................................................
            function getObjectByIdProp(json_array, Id) {
                for (i = 0; i < json_array.length; i++) {
                    if (json_array[i].Id == Id)
                        return json_array[i];
                }
                return null;
            }

            function getObjectsByColorIdAndPolyMaterialIdProps(json_array, colorId, polyMaterialId) {
                var sub_json_array = [];
                if (polyMaterialId === "0") {
                    for (i = 0; i < json_array.length; i++) {
                        if (json_array[i].ColorId == colorId)
                            sub_json_array.push(json_array[i]);
                    }
                    return sub_json_array;
                } else if (colorId === "0") {
                    for (i = 0; i < json_array.length; i++) {
                        if (json_array[i].PolyMaterialId == polyMaterialId)
                            sub_json_array.push(json_array[i]);
                    }
                    return sub_json_array;
                }
                for (i = 0; i < json_array.length; i++) {
                    if (json_array[i].ColorId == colorId && json_array[i].PolyMaterialId == polyMaterialId)
                        sub_json_array.push(json_array[i]);
                }
                return sub_json_array;
            }

            function getSheetSize() {
                var bagTypeInputF = $('#PolyCosting_BagTypeId');

                if (bagTypeInputF.val() !== "0") {

                    var bagTypeObj = getObjectByIdProp(bagTypeJsonArr, bagTypeInputF.val());
                    var sheetSizeFormula = bagTypeObj.SheetSizeFormula.toUpperCase();

                    if (sheetSizeFormula.includes("L")) {
                        if ($('#lengthCmInputF').val() === "") {
                            sheetSizeFormula = "";
                        } else {
                            sheetSizeFormula = sheetSizeFormula.replace("L", $('#lengthCmInputF').val());
                        }
                    }
                    if (sheetSizeFormula.includes("G")) {
