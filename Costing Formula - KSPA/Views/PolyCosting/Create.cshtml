@section Scripts{

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">

        // Global Variables
        const bagTypeJsonArr = @Html.Raw(ViewBag.bagTypeJsonStr);
        const PolyCombJsonArr = @Html.Raw(ViewBag.polyCombinationJsonStr);
        const itemCategoryJsonArr = @Html.Raw(ViewBag.itemCategoryJsonStr);
        const cylinderJsonArr = @Html.Raw(ViewBag.cylinderJsonStr);

        $(document).ready(function () {

            const TURNS_VAL = $('#PolyCosting_Turns').val();
            const PER_UNIT_ADJUSTABLE_UNITPRICE_VAL = $('#PolyCosting_PerUnitAdjustableUnitPrice').val();
            const MEASUREMENT_UOM_VAL= $('#PolyCosting_MeasurementUomId').val();
            const BLOCK_COST_TOTAL_VAL = $('#PolyCosting_BlockCostTotal').val();
            const OTHER_COST_TOTAL_VAL = $('#PolyCosting_OtherCostTotal').val();

            const CYLINDERSELECT_NOOFCOLORS_VS_WASTE_TOLARANCE = 0.1; //cm

            $('#saveBtnErrorSpan').hide();

            $('select.select2').select2({
                theme: 'bootstrap-5'
            });

            $("select.select2-adv-search").select2({
                matcher: matchCustom,
                theme: 'bootstrap-5'
            });

            function matchCustom(params, data) {
                // If there are no search terms, return all of the data
                if ($.trim(params.term) === '') {
                  return data;
                }

                var paramWordArray = params.term.split(" ");
                var atleastOneWordPercent = false;
                var allWordsPercent = true;

                for(var i=0; i<paramWordArray.length; i++) {
                    if (paramWordArray[i] !== '') {
                        if (data.text.toUpperCase().indexOf(paramWordArray[i].toUpperCase()) > -1) {
                            atleastOneWordPercent = true;
                            allWordsPercent = allWordsPercent && true;
                        } else {
                            allWordsPercent = false;
                        }
                    }
                }

                if(atleastOneWordPercent && allWordsPercent) {
                    return data;
                }

                // Return `null` if the term should not be displayed
                return null;
            }

            // Customer Detail Section................................................................
            var cusTypeInputF = $('#cusTypeInputF');
            var cusCurrencyInputF = $('#cusCurrencyInputF');
            var nativeCurrencyLabels = $('.native-currency');
            var exRateInputF = $('#exRateInputF');
            var deliAddressTextA = $('#PolyCosting_DeliveryAddress');

            var customersJsonArr = @Html.Raw(ViewBag.customersJsonStr);

            $("#PolyCosting_CustomerId").change(function () {
                var customer = getObjectByIdProp(customersJsonArr, $(this).val());
                if (customer !== null) {
                    cusTypeInputF.val(customer.CustomerTypeDesc);
                    cusCurrencyInputF.val(customer.CurrencyCode);
                    nativeCurrencyLabels.html(customer.CurrencyCode);
                    exRateInputF.val(customer.RateInLKR);
                    deliAddressTextA.val(customer.CustomerAddress);
                } else {
                    cusTypeInputF.val('');
                    cusCurrencyInputF.val('');
                    nativeCurrencyLabels.html('Native Currency')
                    exRateInputF.val('');
                    deliAddressTextA.val('');
                }
                updateRawMaterialGrid_onChange();
                updateAdjSalesPrice_onKeyup();
            });
            // run once above onChangeBody
            var customer = getObjectByIdProp(customersJsonArr, $("#PolyCosting_CustomerId").val());
            if (customer !== null) {
                cusTypeInputF.val(customer.CustomerTypeDesc);
                cusCurrencyInputF.val(customer.CurrencyCode);
                nativeCurrencyLabels.html(customer.CurrencyCode);
                exRateInputF.val(customer.RateInLKR);
                deliAddressTextA.val(customer.CustomerAddress);
            } else {
                cusTypeInputF.val('');
                cusCurrencyInputF.val('');
                nativeCurrencyLabels.html('Native Currency');
                exRateInputF.val('');
                deliAddressTextA.val('');
            }
            updateRawMaterialGrid_onChange();
            updateAdjSalesPrice_onKeyup();


            // Poly Combination Detail Section.........................................................
            var polyCombInputF = $('#polyCombInputF');

            $("#PolyCosting_PolyCombId").change(function () {
                var polyCombination = getObjectByIdProp(PolyCombJsonArr, $(this).val());
                if (polyCombination !== null) {
                    polyCombInputF.val(polyCombination.PolyCombDesc);
                } else {
                    polyCombInputF.val('');
                }
                updateRawMaterialGrid_onChange();
                updateRawMaterialGrid_onChange();
            });
            // run once above onChangeBody
            var polyCombination = getObjectByIdProp(PolyCombJsonArr, $("#PolyCosting_PolyCombId").val());
            if (polyCombination !== null) {
                polyCombInputF.val(polyCombination.PolyCombDesc);
            } else {
                polyCombInputF.val('');
            }
            updateRawMaterialGrid_onChange();
            updateRawMaterialGrid_onChange();

            // Filter For Poly Combination.............................................................
            var colorsSelectBx = $('#colorsSelectBx');
            var polyMaterialSelectBx = $('#polyMaterialSelectBx');

            var fullPolyCombJsonArr = @Html.Raw(ViewBag.polyCombinationJsonStr);

            // A. On color select box change filder.
            colorsSelectBx.change(function () {
                var optionsString = '';
                var partialPolyCombJsonArr;
                if ($(this).val() === "0" && polyMaterialSelectBx.val() === "0") {
                    $("#PolyCosting_PolyCombId").html(function () {
                        fullPolyCombJsonArr.forEach(function (currentValue) {
                            optionsString += '<option value="' + currentValue.Id + '">' + currentValue.PolyCombDesc + " (" + currentValue.PolyCombCode + ")" + "</option>"
                        });
                        if (optionsString === '')
                            return `<option>--Update masters, no data--</option>`;
                        else
                            return `<option>-- Select --</option>` + optionsString;
                    });
                } else {
                    partialPolyCombJsonArr = getObjectsByColorIdAndPolyMaterialIdProps(fullPolyCombJsonArr, colorsSelectBx.val(), polyMaterialSelectBx.val());
