            function updateRawMaterialGrid_onChange() {

                var rawMaterialsTable = $('#rawMaterialsTable');
                var polyCombinationSelectB = $('#PolyCosting_PolyCombId'); //1

                if (polyCombinationSelectB.val() !== "0") {
                    var polyCombObj = getObjectByIdProp(PolyCombJsonArr, polyCombinationSelectB.val());
                    var polyCombItemCatBridgesArr = polyCombObj.PolyCombItemCatBridges; // Contains {Id: ItemCatIdHere, Percentage: PercentageHere, UnitPrice: price, UnitDuty: duty} array
                    rawMaterialsTable.find('tbody').empty();
                    for (var i = 0; i < polyCombItemCatBridgesArr.length; i++) {
                        var itemCatObjet = getObjectByIdProp(itemCategoryJsonArr, polyCombItemCatBridgesArr[i].Id);
                        var unitPrice = polyCombItemCatBridgesArr[i].UnitPrice;
                        var unitDuty = polyCombItemCatBridgesArr[i].UnitDuty;

                        // give alert if item category price has not updated
                        if (unitPrice === 0) {
                            alert("Unit Price Per Unit is 0 of the item category: " + itemCatObjet.ItemCategoryDesc +
                                "\nFirst update the Item Category Price transaction!");
                        }

                        var weightInputF = $('#PolyCosting_Weight'); //2

                        // set standard consumption
                        var stdConsumption = 0.0000;
                        if (weightInputF.val() !== "") {
                            stdConsumption = (Number(weightInputF.val()) * Number(polyCombItemCatBridgesArr[i].Percentage) / 100).toFixed(4);
                        }

                        // set pre costing waste
                        var preCostingWaste = 0.0000;
                        var preCostingWastePercentInputF = $('#PolyCosting_PreCostingWastePercentage'); //3
                        if (preCostingWastePercentInputF.val() !== "") {
                            preCostingWaste = (Number(stdConsumption) * Number(preCostingWastePercentInputF.val()) / 100).toFixed(4);
                        }

                        // set category wise total weight in the grid
                        var catWiseTotalWeight = 0.0000;
                        catWiseTotalWeight = (Number(stdConsumption) + Number(preCostingWaste)).toFixed(4);

                        // set category wise unit weight
                        var catWiseUnitWeight = 0.0000;
                        var orderQtyInputF = $('#PolyCosting_OrderQty'); //4
                        if (orderQtyInputF.val() !== "") {
                            catWiseUnitWeight = (Number(catWiseTotalWeight) / Number(orderQtyInputF.val())).toFixed(4);
                        }

                        // set unit cost
                        var unitCost = 0.0000;
                        var cusTypeInputF = $('#cusTypeInputF'); //5
                        if (cusTypeInputF.val().toLowerCase() === "local") {
                            unitCost = ((Number(unitPrice) + Number(unitDuty)) * Number(catWiseUnitWeight)).toFixed(4);
                        } else {
                            unitCost = (Number(unitPrice) * Number(catWiseUnitWeight)).toFixed(4);
                        }

                        rawMaterialsTable.find('tbody').append(
                            `
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control" value="` + itemCatObjet.ItemCategoryDesc + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + polyCombItemCatBridgesArr[i].Percentage + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + unitPrice + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + unitDuty + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + stdConsumption + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + preCostingWaste + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + catWiseTotalWeight + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" value="` + catWiseUnitWeight + `" disabled/>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control unitCostInputFs" value="` + unitCost + `" disabled/>
                                        </td>
                                    </tr>`
                        );
                    }
                } else {
                    // set grid = ""
                    rawMaterialsTable.find('tbody').empty();
                }

                updateSummaryGrid_onChange();
            }

            function updateSummaryGrid_onChange() {

                // Weight section.................................................................................
                var weightTotalInputF = $('#weightTotalInputF');
                var weightPerUnitInputF = $('#weightPerUnitInputF');

                var weightInputF = $('#PolyCosting_Weight'); //1
                var pCWastePrecentInputF = $('#PolyCosting_PreCostingWastePercentage'); //2
                var orderQtyInputF = $('#PolyCosting_OrderQty'); //3
                var unitCostInputFs = $('.unitCostInputFs'); //4

                // set weightTotal field
                var weightTotal = 0;
                if (weightInputF.val() !== "" || pCWastePrecentInputF.val() !== "") {
                    weightTotal = Number(weightInputF.val()) * (100 + Number(pCWastePrecentInputF.val())) / 100;
                    weightTotalInputF.val(weightTotal.toFixed(4)); // weightTotalInputF can be empty string
                } else {
                    weightTotalInputF.val("");
                }

                // set weightPerUnit input field
                if (orderQtyInputF.val() !== "") {
                    weightPerUnitInputF.val(
                        ( weightTotal / Number(orderQtyInputF.val()) ).toFixed(4)
                    );
                } else {
                    weightPerUnitInputF.val("");
                }

                // Material cost section.................................................................................
                var matCostTotalInputF = $('#matCostTotalInputF');
                var matCostPerUnitInputF = $('#matCostPerUnitInputF');
                var matCostPerKgInputF = $('#matCostPerKgInputF');
                var adjSalesPricePerUnit = $('#PolyCosting_PerUnitAdjustableUnitPrice');

                if (unitCostInputFs.length !== 0) {
                    var matCostTotal = 0;
                    // set mat cost per unit
                    for (var i = 0; i < unitCostInputFs.length; i++) {
                        if (!isNaN(parseFloat($(unitCostInputFs[i]).val())))
                            matCostTotal += Number($(unitCostInputFs[i]).val());
                    }
                    matCostPerUnitInputF.val(matCostTotal.toFixed(4));
                    // set mat cost total
                    if (orderQtyInputF.val() !== "0.0000") {
                        matCostTotalInputF.val((matCostTotal * Number(orderQtyInputF.val())).toFixed(4));
                    } else {
                        matCostTotalInputF.val("0.0000");
                    }
                    // set mat cost per kg
                    if (weightInputF.val() !== "0.0000") {
                        matCostPerKgInputF.val((Number(orderQtyInputF.val()) * matCostTotal / weightTotal).toFixed(4)); // Correction: weight should be weightTotalInputF - corrected
                    } else {
                        matCostPerKgInputF.val("0.0000");
                    }
                } else {
                    matCostTotalInputF.val("0.0000");
                    matCostPerUnitInputF.val("0.0000");
                    matCostPerKgInputF.val("0.0000");
                }

                // Overhead cost section.................................................................................
                var overHeadCostInputF = $('#overHeadCostInputF');
                var ohcTotal = Number(overHeadCostInputF.val()) * weightTotal;
                $('#overHeadCostTotalInputF').val(ohcTotal.toFixed(4));
                $('#overHeadCostPerUnitInpurF').val(
                    (ohcTotal / Number(orderQtyInputF.val())).toFixed(4)
                );

                // Block cost section....................................................................................
                var blockCostTotalInputF = $('#PolyCosting_BlockCostTotal');
                $('#blockCostPerUnitInpurF').val(
                    ( Number(blockCostTotalInputF.val()) / Number(orderQtyInputF.val()) ).toFixed(4)
                );
                $('#blockCostInputF').val(
                    (Number(blockCostTotalInputF.val()) / weightTotal).toFixed(4)
                );

                // Other cost section....................................................................................
                var otherCostTotalInputF = $('#PolyCosting_OtherCostTotal');
                $('#otherCostPerUnitInpurF').val(
                    ( Number(otherCostTotalInputF.val()) / Number(orderQtyInputF.val()) ).toFixed(4)
                );
                $('#otherCostsInputF').val(
                    (Number(otherCostTotalInputF.val()) / weightTotal).toFixed(4)
                );

                // Total section.........................................................................................
                var totalPerUnit = Number($('#matCostPerUnitInputF').val()) + Number($('#overHeadCostPerUnitInpurF').val())
                    + Number($('#blockCostPerUnitInpurF').val()) + Number($('#otherCostPerUnitInpurF').val());
                $('#totalPerUnit').val(
                    totalPerUnit.toFixed(4)
                );

                var totalTotal = Number($('#matCostTotalInputF').val()) + Number($('#overHeadCostTotalInputF').val())
                    + Number($('#PolyCosting_BlockCostTotal').val()) + Number($('#PolyCosting_OtherCostTotal').val());
                $('#totalTotal').val(
                    totalTotal.toFixed(4)
                );

                var totalPerKg = Number($('#matCostPerKgInputF').val()) + Number($('#overHeadCostInputF').val())
                    + Number($('#blockCostInputF').val()) + Number($('#otherCostsInputF').val());
                $('#totalPerKg').val(
                    totalPerKg.toFixed(4)
                );

                var salesPricePerUnit = totalPerUnit * 125 / 100;
                $('#salesPricePerUnit').val(salesPricePerUnit.toFixed(4));
                var salesPriceTotal = totalTotal * 125 / 100;
                $('#salesPriceTotal').val(salesPriceTotal.toFixed(4));
                var salesPricePerKg = totalPerKg * 125 / 100;
                $('#salesPricePerKg').val(salesPricePerKg.toFixed(4));

                // new start: sales price in native currency
                var exRateInputF = $('#exRateInputF');

                var salesPricePerUnitInNativeC = salesPricePerUnit / Number(exRateInputF.val());
                $('#PolyCosting_PerUnitSuggestedUnitPrice').val(
                    salesPricePerUnitInNativeC.toFixed(4)
                );
                var salesPriceTotalInNativeC = salesPriceTotal / Number(exRateInputF.val());
                $('#nativeSalesPriceTotal').val(
                    salesPriceTotalInNativeC.toFixed(4)
                );
                var salesPricePerKgInNativeC = salesPricePerKg / Number(exRateInputF.val());
                $('#nativeSalesPricePerKg').val(
                    salesPricePerKgInNativeC.toFixed(4)
                );

                // Adjustable sales price (in native currency)
                $('#PolyCosting_PerUnitAdjustableUnitPrice').val(salesPricePerUnitInNativeC.toFixed(4));
                $('#adjSalesPriceTotal').val(salesPriceTotalInNativeC.toFixed(4));
                $('#adjSalesPricePerKg').val(salesPricePerKgInNativeC.toFixed(4));

                $('#adjProfitPercentPerUnit').val("25.00%");
                $('#adjProfitPercentTotal').val("25.00%");
                $('#adjProfitPercentPerKg').val("25.00%");

                updateAdjSalesPrice_onKeyup();
            }

