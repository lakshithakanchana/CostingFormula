                } else if(printByLengthRadioB.is(':checked')) {
                    tempLength = Number(lengthCmInputF.val());
                } else {
                    tempLength = 0;
                    if(printedCheckB.is(':checked')) {
                        alert('Please, select the "Bag ty. / Reel ty. code" to search for suitable cylinders!!');
                    }
                }

                var suitableClindersArray = [];
                var minWastage = null;
                var minWastingCylinder = null;
                var turns = null;

                // finding the lowest waste clinder and all suitable clinders list
                if(tempLength !== 0 && autoClinderSelectionCheckB.is(':checked') && printedCheckB.is(':checked')) {
                
                    cylinderJsonArr.forEach(function(cylinder) {
                    
                        if(isNaN(parseInt(noOfColorsInputF.val())) || isNaN(parseInt(printingSidesCountInputF.val()))) {
                            // show all cylinders, selected val = "-- select cylinder --".
                            cylinderSelectB.empty();
                            var allOptionsString = '<option value="" selected>-- select cylinder --</option>';
                            cylinderJsonArr.forEach(function(cylinder) {
                                allOptionsString += '<option value="' + cylinder.Id + '">' + cylinder.CylinderCode + '</option>';
                            });
                            cylinderSelectB.append(allOptionsString);
                            cylinderSelectB_onChange();
                            alert('Please, fill both "No of colors" and "Printing sides count" to find suitable cylinders!');
                        } else if(cylinder.NoOfColors >= parseInt(noOfColorsInputF.val()) * parseInt(printingSidesCountInputF.val())) {

                            suitableClindersArray.push(cylinder);

                            if(minWastage === null || minWastingCylinder === null || turns === null) {
                                var temp_minWastage = cylinder.CylinderSizeCm - tempLength / 2;
                                if(temp_minWastage > 0) {
                                    minWastage = temp_minWastage;
                                    minWastingCylinder = cylinder;
                                    turns = 2;
                                } else {
                                    temp_minWastage = cylinder.CylinderSizeCm - tempLength;
                                    if(temp_minWastage > 0) {
                                        minWastage = temp_minWastage;
                                        minWastingCylinder = cylinder;
                                        turns = 1;
                                    } else {
                                        temp_minWastage = cylinder.CylinderSizeCm - tempLength * 2 ;
                                        if(temp_minWastage > 0) {
                                            minWastage = temp_minWastage;
                                            minWastingCylinder = cylinder;
                                            turns = 1/2;
                                        }
                                    }
                                }
                            }

                            const tolarance = CYLINDERSELECT_NOOFCOLORS_VS_WASTE_TOLARANCE;
                            if(minWastage !== null || minWastingCylinder !== null || turns !== null) {
                                var oneByTwoWaste = cylinder.CylinderSizeCm - tempLength / 2;
                                if(oneByTwoWaste > 0) {
                                    if(minWastage > oneByTwoWaste) {
                                        minWastage = oneByTwoWaste;
                                        minWastingCylinder = cylinder;
                                        turns = 2;
                                    } else if((minWastage - oneByTwoWaste < tolarance && minWastage - oneByTwoWaste > 0) || (oneByTwoWaste - minWastage < tolarance && oneByTwoWaste - minWastage > 0)) {
                                        minWastage = oneByTwoWaste;
                                        minWastingCylinder = cylinder;
                                        turns = 2;
                                    }
                                }
                                var oneWaste = cylinder.CylinderSizeCm - tempLength;
                                if(oneWaste > 0) {
                                    if(minWastage > oneWaste) {
                                        minWastage = oneWaste;
                                        minWastingCylinder = cylinder;
                                        turns = 1;
                                    } else if((minWastage - oneWaste < tolarance && minWastage - oneWaste > 0) || (oneWaste - minWastage < tolarance && oneWaste - minWastage > 0)) {
                                        minWastage = oneWaste;
                                        minWastingCylinder = cylinder;
                                        turns = 1;
                                    }
                                }
                                var twoWaste = cylinder.CylinderSizeCm - tempLength * 2;
                                if(twoWaste > 0) {
                                    if(minWastage > twoWaste) {
                                        minWastage = twoWaste;
                                        minWastingCylinder = cylinder;
                                        turns = 1/2;
                                    } else if((minWastage - twoWaste < tolarance && minWastage - twoWaste > 0) || (twoWaste - minWastage < tolarance && twoWaste - minWastage > 0)) {
                                        minWastage = twoWaste;
                                        minWastingCylinder = cylinder;
                                        turns = 1/2;
                                    }
                                }
                            }

                        }

                    }); // foreach loop ends.

                    if(minWastage !== null && minWastingCylinder !== null && turns !== null) {
                    
                        iziToast.success({
                            title: 'Ok',
                            message: 'A suitable cylinder found! Waste is just: ' + minWastage.toFixed(4) + " cm.",
                            position: 'topRight',
                            timeout: 15000
                        });

                        // set option list to cylinder select box
                        cylinderSelectB.empty();
                        var optionString = '';
                        suitableClindersArray.forEach(function(cylinder) {
                            optionString += '<option value="' + cylinder.Id + '">' + cylinder.CylinderCode + '</option>';
                        });
                        cylinderSelectB.append(optionString);
                        // set selected value to cylinder select box
                        cylinderSelectB.val(minWastingCylinder.Id);
                        cylinderSelectB_onChange();
                        // set turns
                        turnsTextB.val(turns.toFixed(4));
                        setNoOfMetersInputF_onChange();
                    } else {
                        // show all cylinders, selected val = "-- select cylinder --".
                        cylinderSelectB.empty();
                        var allOptionsString = '<option value="" selected>-- select cylinder --</option>';
                        cylinderJsonArr.forEach(function(cylinder) {
                            allOptionsString += '<option value="' + cylinder.Id + '">' + cylinder.CylinderCode + '</option>';
                        });
                        cylinderSelectB.append(allOptionsString);
                        cylinderSelectB_onChange();
                        alert("There is no suitable cylinders in the Cylinder Master yet!");
                    }

                } else {
                    // show all cylinders, selected val = "-- select cylinder --".
                    cylinderSelectB.empty();
                    var allOptionsString = '<option value="" selected>-- select cylinder --</option>';
                    cylinderJsonArr.forEach(function(cylinder) {
                        allOptionsString += '<option value="' + cylinder.Id + '">' + cylinder.CylinderCode + '</option>';
                    });
                    cylinderSelectB.append(allOptionsString);
                    cylinderSelectB_onChange();
                }

            }

            function setPreCostingWaste_onChange() {
                var preCostingWasteInputF = $('#PolyCosting_PreCostingWastePercentage');
                var noOfColorsInputF = $('#PolyCosting_NoOfColors'); // 1
                const preCostWasteMinFor0Colors = 5;

                var noOfCols = Number(noOfColorsInputF.val());
                if(noOfCols <= 1) {
                    preCostingWasteInputF.val(
                        preCostWasteMinFor0Colors * 1
                    );
                    preCostingWasteInputF.attr(
                        'min',
                        preCostWasteMinFor0Colors * 1
                    );
                } else if(noOfCols <= 2) {
                    preCostingWasteInputF.val(
                        preCostWasteMinFor0Colors * 2
                    );
                    preCostingWasteInputF.attr(
                        'min',
                        preCostWasteMinFor0Colors * 2
                    );
                } else if(noOfCols <= 3) {
                    preCostingWasteInputF.val(
                        preCostWasteMinFor0Colors * 3
                    );
                    preCostingWasteInputF.attr(
                        'min',
                        preCostWasteMinFor0Colors * 3
                    );
                } else if(noOfCols > 3) {
                    preCostingWasteInputF.val(
                        preCostWasteMinFor0Colors * 4
                    );
                    preCostingWasteInputF.attr(
                        'min',
                        preCostWasteMinFor0Colors * 4
                    );
                } else {
                    preCostingWasteInputF.val(
                        preCostWasteMinFor0Colors * 1
                    );
                    preCostingWasteInputF.attr(
                        'min',
                        preCostWasteMinFor0Colors * 1
                    );
                }
                $("form").removeData("validator").removeData("unobtrusiveValidation");
                //Parse the form again
                $.validator.unobtrusive.parse($("form"));

                setNoOfMetersInputF_onChange();
            }

        });

    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}