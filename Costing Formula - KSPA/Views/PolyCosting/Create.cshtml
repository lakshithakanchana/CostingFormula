@model Costing_Formula___KSPA.Models.ViewModels.PolyCostingVM

@{
    ViewData["Title"] = "Create New Quotation";
    ViewData["StypeHRef1"] = "https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css";
    ViewData["StypeHRef2"] = "https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Create New Quotation - Polythene</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-primary btn-outline-light border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Create">
    <div class="row">

        <div class="col-md-12 mt-3">
            <h2 class="h5 d-none"><u>Document Specification Section</u></h2>
        </div>

        <input type="hidden" asp-for="PolyCosting.PolyCostingId" />

        <!-- Doc date -->
        <div class="col-6 col-md-3">
            <div class="mb-3">
                <!-- To add some margin between form-controls -->
                <label asp-for="PolyCosting.DateCreated" class="form-label">Doc date &ast;</label>
                <input type="date" class="form-control" asp-for="PolyCosting.DateCreated" placeholder="Doc date" min=@(DateTime.Today.ToString("yyyy-MM-dd")) max=@(DateTime.Today.ToString("yyyy-MM-dd"))>
                <b><span class="text-danger" asp-validation-for="PolyCosting.DateCreated"></span></b>
            </div>
        </div>

        <!-- Quotation No -->
        <div class="col-6 col-md-3">
            <div class="mb-3">
                <!-- To add some margin between form-controls -->
                <label asp-for="PolyCosting.PolyCostingCode" class="form-label">Quatation No</label>
                <input type="text" class="form-control" asp-for="PolyCosting.PolyCostingCode" placeholder="System will generate for you" disabled>
                <b><span class="text-danger" asp-validation-for="PolyCosting.PolyCostingCode"></span></b>
            </div>
        </div>

        <!-- Company Name -->
        <div class="col-md-6">
            <div class="mb-3 text-white">
                <!-- To add some margin between form-controls -->
                <label asp-for="PolyCosting.CompanyId" class="form-label">Company name &ast;</label>
                <select class="form-select"
                       
                        asp-for="PolyCosting.CompanyId"
                        asp-items="@Model.CompanyDropDown"
                        tabindex="1">
                    <option selected>-- select company --</option>
                </select>
                <b><span class="text-danger" asp-validation-for="PolyCosting.CompanyId"></span></b>
            </div>
        </div>

        <div class="col-12">
            <hr class="bg-primary border-2 border-primary" />
        </div>

        <div class="col-md-12 mt-3">
            <h2 class="h5"><u>Customer Detail Section</u></h2>
        </div>

        <div class="col-12">
            <div class="row">
                <!-- customer detail except address -->
                <div class="col-md-6">
                    <div class="row">
                        <!-- Customer Name -->
                        <div class="col-md-12">
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.CustomerId" class="form-label">Customer name &ast;</label>
                                <select class="select2 form-select"
                                       
                                        asp-for="PolyCosting.CustomerId"
                                        asp-items="@Model.CustomerDropDown"
                                        tabindex="2">
                                    <option selected>-- select customer --</option>
                                </select>
                                <b><span class="text-danger" asp-validation-for="PolyCosting.CustomerId"></span></b>
                            </div>
                        </div>
                    </div>
                </div><!-- End of customer derail except address -->
                <!-- Customer Address Text Area -->
                <div class="col-md-6">
                    <div class="row d-none">
                        <!-- Delivery address -->
                        <div class="col-12">
                            <div class="form-group mb-3 text-white">
                                <label asp-for="PolyCosting.DeliveryAddress" class="form-label">Delivery address &ast;</label>
                                <textarea class="form-control" asp-for="PolyCosting.DeliveryAddress" rows="4" tabindex="3"></textarea>
                                <b><span class="text-danger" asp-validation-for="PolyCosting.DeliveryAddress"></span></b>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <!-- Customer Type -->
                        <div class="col-md-4">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="cusTypeInputF" class="form-label">Cus. type</label>
                                <input type="text" class="form-control" id="cusTypeInputF" placeholder="Customer type" disabled>
                            </div>
                        </div>

                        <!-- Customer Currency (Code) -->
                        <div class="col-6 col-md-4">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="cusCurrencyInputF" class="form-label">Cus. currency</label>
                                <input type="text" class="form-control" id="cusCurrencyInputF" placeholder="Customer currency" disabled>
                            </div>
                        </div>

                        <!-- Exchange rate in LKR (Code) -->
                        <div class="col-6 col-md-4">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="exRateInputF" class="form-label">Exchange rate</label>
                                <input type="text" class="form-control" id="exRateInputF" placeholder="Exchange rate" disabled>
                            </div>
                        </div>
                    </div>
                </div><!-- End of Customer Address Text Area -->
            </div>
        </div>

        <!-- Poly Combination Section -->
        <div class="col-md-12">
            <div class="row">

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Poly Combination Section</u></h2>
                </div>

                <!-- Color -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label for="colorsSelectBx" class="form-label"><span class="text-warning">Filter by</span> color</label>
                        <select class="form-select"
                               
                                id="colorsSelectBx"
                                asp-items="@Model.ColorDropDown"
                                tabindex="4">
                            <option value="0">-- ALL --</option>
                        </select>
                    </div>
                </div>

                <!-- Poly Material -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label for="polyMaterialSelectBx" class="form-label"><span class="text-warning">Filter by</span> p-mat.</label>
                        <select class="form-select"
                               
                                id="polyMaterialSelectBx"
                                asp-items="@Model.PolyMaterialDropDown"
                                tabindex="5">
                            <option value="0">-- ALL --</option>
                        </select>
                    </div>
                </div>

                <!-- Combination Code -->
                <div class="col-sm-6">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCosting.PolyCombId" class="form-label">Poly-comb code &ast;</label>
                        <select class="form-select select2"
                               
                                asp-for="PolyCosting.PolyCombId"
                                asp-items="@Model.PolyCombinationDropDown"
                                tabindex="6">
                            <option value="0" selected>-- select --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="PolyCosting.PolyCombId"></span></b>
                    </div>
                </div>

                <!-- Poly combination desc -->
                <div class="col-12 d-none">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label for="polyCombInputF" class="form-label">Poly combination</label>
                        <input type="text" class="form-control" id="polyCombInputF" placeholder="Poly combination" disabled>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Bag Type Details Section</u></h2>
                </div>

                <!-- Bag type -->
                <div class="col-md-4">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCosting.BagTypeId" class="form-label">Bag ty. / Reel ty. code &ast;</label>
                        <select class="select2-adv-search form-select"
                               
                                asp-for="PolyCosting.BagTypeId"
                                asp-items="@Model.BagTypeDropDown"
                                tabindex="7">
                            <option value="0" selected>-- select --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="PolyCosting.BagTypeId"></span></b>
                    </div>
                </div>

                <!-- Product Finishing Type Input Field -->
                <div class="col-6 col-md-2">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label for="productFinishingTypeInputF" class="form-label">Prod. fin. type</label>
                        <input type="text" class="form-control" id="productFinishingTypeInputF" placeholder="Product finishing type" disabled>
                    </div>
                </div>

                <!-- Raio group section: p_by_with, p_by_length -->
                <div class="col-6 col-md-6">
                    <label class="form-label mb-3">Printing direction:</label>
                    <div class="row">
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="form-check mb-3">
                                <input id="printByWidth" class="form-check-input" type="radio" for="BagType.PrintByWidthOrLength"
                                       name="printByWOrL" disabled />
                                <label class="form-check-label" for="printByWidth">
                                    Print by <b>Width</b>
                                </label>
                            </div>
                        </div>
                        <!-- Print by length radio button -->
                        <div class="col-sm-6 col-md-8 col-lg-9">
                            <div class="form-check mb-3">
                                <input id="printByLength" class="form-check-input" type="radio" for="BagType.PrintByWidthOrLength"
                                       name="printByWOrL" disabled />
                                <label class="form-check-label" for="printByLength">
                                    Print by <b>Length</b>
                                </label>
                            </div>
                            <b><span class="text-danger" for="BagType.PrintByWidthOrLength"></span></b>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Order Specification Section</u></h2>
                </div>

                <!-- UOM for QTY -->
                <div class="col-sm-3 d-none">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCosting.OrderUomId" class="form-label">UOM <span class="text-warning">(for Qty)</span> &ast;</label>
                        <select class="form-select"
                               
                                id="uomQtyOrKgSelectB"
                                asp-items="@Model.OrderUomDropDown" disabled>
                            <option value="0" selected>-- Unit --</option>
                        </select>
                        <input type="hidden" asp-for="PolyCosting.OrderUomId" />
                        <b><span class="text-danger" asp-validation-for="PolyCosting.OrderUomId"></span></b>
                    </div>
                </div>

                <!-- Special Instructions -->
                <div class="col-12">
                    <div class="form-group mb-3 text-white">
                        <label asp-for="PolyCosting.SpecialInstructions" class="form-label">Special instructions</label>
                        <textarea class="form-control" asp-for="PolyCosting.SpecialInstructions" rows="1"
                                  placeholder="If any, special instructions can be put here." tabindex="9"></textarea>
                        <b><span class="text-danger" asp-validation-for="PolyCosting.SpecialInstructions"></span></b>
                    </div>
                </div>

            </div>
        </div><!-- End of Procuct Specification Section -->

        <!-- Product Messurement Section -->
        <div class="col-12">
            <div class="row">

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Product Measurement Section</u></h2>
                </div>

                <div class="col-12">
                    <!-- Row: product measurement -->
                    <div class="row">
                        
                        <!-- Selected UOM -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.MeasurementUomId" class="form-label text-warning fw-bold">Select UOM</label>
                                <select class="form-select fw-bold"
                                       
                                        asp-for="PolyCosting.MeasurementUomId"
                                        asp-items="@Model.LengthUomDropDown"
                                        readonly
                                        tabindex="10">
                                    <option value="0" selected>-- UOM --</option>
                                </select>
                                <b><span class="text-danger" asp-validation-for="PolyCosting.MeasurementUomId"></span></b>
                            </div>
                        </div>

                        <!-- System UOM -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label class="form-label text-warning fw-bold">System UOM</label>
                                <input type="text" class="form-control text-warning fw-bold" value="cm" disabled>
                            </div>
                        </div>

                        <!-- Guage -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.Guage" class="form-label">Guage &ast;</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.Guage" placeholder="Guage in selected UOM" tabindex="11">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.Guage"></span></b>
                            </div>
                        </div>

                        <!-- Guage -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="guageInputF2" class="form-label">Guage</label>
                                <input type="text" class="form-control" id="guageInputF2" placeholder="Guage" disabled>
                            </div>
                        </div>

                        <!-- Width -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.Width" class="form-label">Width (UOM) &ast;</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.Width" placeholder="Width in selected UOM" tabindex="12">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.Width"></span></b>
                            </div>
                        </div>

                        <!-- Width -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="widthCmInputF" class="form-label">Width (cm)</label>
                                <input type="text" class="form-control" id="widthCmInputF" placeholder="Width in cm" disabled>
                            </div>
                        </div>

                        <!-- Length -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.Length" class="form-label">Length (UOM)</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.Length" placeholder="Length in selected UOM" tabindex="13">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.Length"></span></b>
                            </div>
                        </div>

                        <!-- Length -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="lengthCmInputF" class="form-label">Length (cm)</label>
                                <input type="text" class="form-control" id="lengthCmInputF" placeholder="Length in cm" disabled>
                            </div>
                        </div>

                        <!-- Gusset -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.Gusset" class="form-label">Gusset (UOM)</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.Gusset" placeholder="Gusset in selected UOM" tabindex="14">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.Gusset"></span></b>
                            </div>
                        </div>

                        <!-- Gusset -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="gussetCmInputF" class="form-label">Gusset (cm)</label>
                                <input type="text" class="form-control" id="gussetCmInputF" placeholder="Gusset in cm" disabled>
                            </div>
                        </div>

                        <!-- Flap Width -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.FlapWidth" class="form-label">Flap width (UOM)</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.FlapWidth" placeholder="Flap width in selected UOM" tabindex="15">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.FlapWidth"></span></b>
                            </div>
                        </div>

                        <!-- Flap Width -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="flapCmInputF" class="form-label">Flap width (cm)</label>
                                <input type="text" class="form-control" id="flapCmInputF" placeholder="Flap width in cm" disabled>
                            </div>
                        </div>

                        <!-- Selected UOM -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <!-- d-none d-md-block -->
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label for="selected_uom" class="form-label text-warning fw-bold">Selected UOM</label>
                                <input type="text" class="form-control text-warning fw-bold" id="selected_uom" disabled>
                            </div>
                        </div>

                        <!-- System UOM -->
                        <div class="col-6 col-sm-4 col-md-3 d-none"><!-- d-none d-md-block -->
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label class="form-label text-warning fw-bold">System UOM</label>
                                <input type="text" class="form-control text-warning fw-bold" value="cm" disabled>
                            </div>
                        </div>

                        <!-- Bottom Gusset -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.BottomGusset" class="form-label">Bottom gusset</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.BottomGusset" placeholder="Bottom gusset in selected UOM" tabindex="16">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.BottomGusset"></span></b>
                            </div>
                        </div>

                        <!-- Bottom Gusset -->
                        <div class="col-6 col-sm-4 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="bottomGussetCmInputF" class="form-label">Bottom gusset (cm)</label>
                                <input type="text" class="form-control" id="bottomGussetCmInputF" placeholder="Bottom gusset in cm" disabled>
                            </div>
                        </div>

                        <!-- Order Qty -->
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="mb-6">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="PolyCosting.OrderQty" class="form-label">Order Qty &ast;</label>
                                <input type="text" class="form-control" asp-for="PolyCosting.OrderQty" placeholder="Qty in the selected UOM" tabindex="16">
                                <b><span class="text-danger" asp-validation-for="PolyCosting.OrderQty"></span></b>
                            </div>
                        </div>

                    </div><!-- End of Row: product measurement -->
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Printing Detail Section</u></h2>
                </div>

                <!-- Printed? checkbox -->
                <div class="col-sm-3">
                    <div class="form-check mt-4 mb-3">
                        <input class="form-check-input" asp-for="PolyCosting.Printed" tabindex="17" style="width: 1.5em; height: 1.5em;">
                        <label class="form-check-label" asp-for="PolyCosting.Printed" style="font-size: 1.5em;">
                            &nbsp;&nbsp;Printed?
                        </label>
                        <b><span class="text-danger" asp-validation-for="PolyCosting.Printed"></span></b>
                    </div>
                </div>

                <!-- Without cylinder base? checkbox -->
                <div class="col-6 d-none">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="" id="withoutCylinderBaseCheckB" disabled>
                        <label class="form-check-label" for="withoutCylinderBaseCheckB">
                            Without cylinder base?
                        </label>
                    </div>
                </div>

                <!-- No of colors -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCosting.NoOfColors" class="form-label">No of colors</label>
                        <input type="text" class="form-control" asp-for="PolyCosting.NoOfColors" placeholder="No of colors" tabindex="18">
                        <b><span class="text-danger" asp-validation-for="PolyCosting.NoOfColors"></span></b>
                    </div>
                </div>

                <!-- Printing side -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCosting.NoOfPrintingSides" class="form-label">Printing sides count</label>
                        <input type="text" class="form-control" asp-for="PolyCosting.NoOfPrintingSides" placeholder="Printing side" tabindex="19">
                        <b><span class="text-danger" asp-validation-for="PolyCosting.NoOfPrintingSides"></span></b>
                    </div>
                </div>

                <!-- Print Type -->
                <div class="col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCosting.PrintTypeId" class="form-label">Print type</label>
                        <select class="select2 form-select"
                               
                                asp-for="PolyCosting.PrintTypeId"
                                asp-items="@Model.PrintTypeDropDown"
                                tabindex="20">
                            <option value="" selected>-- select print type --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="PolyCosting.PrintTypeId"></span></b>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Cylinder Selection Section</u></h2>
                </div>

                <!-- Auto cylinder selection -->
                <div class="col-md-12 col-xl-6 d-none">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" asp-for="PolyCosting.AutoCylinderSelection" tabindex="21" checked>
                        <label class="form-check-label" asp-for="PolyCosting.AutoCylinderSelection">
                            Auto cylinder selection
                        </label>
                        <b><span class="text-danger" asp-validation-for="PolyCosting.AutoCylinderSelection"></span></b>
                    </div>
                </div>

                <!-- Cylinder -->
                <div class="col-md-4 col-xl-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
