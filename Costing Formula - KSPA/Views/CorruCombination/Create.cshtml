@model Costing_Formula___KSPA.Models.ViewModels.CorruCombinationVM;

@{
    ViewData["Title"] = "Corru Combination Master - Add New";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Corru Combination Master - Add New</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
            <a class="btn btn-secondary border border-2" asp-action="ImportFromCsv"><i class="fa-regular fa-upload"></i> Import From CSV</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Create">
    <div class="row">

        <!-- Col for the corru comb code input field -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="mb-3  text-white">
                <!-- mb-3 to add some margin between form-controls -->
                <label asp-for="CorruCombination.CorruCombCode" class="form-label">Corru comb. code </label>
                <input type="text" class="form-control" asp-for="CorruCombination.CorruCombCode" placeholder="As in Axpert">
                <b><span class="text-danger" asp-validation-for="CorruCombination.CorruCombCode"></span></b>
            </div>
        </div>

        <!-- Col for the color selection box -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="mb-3 text-white">
                <!-- To add some margin between form-controls -->
                <label asp-for="CorruCombination.ColorId" class="form-label">Color</label>
                <select class="form-select" asp-for="CorruCombination.ColorId" asp-items="@Model.ColorDropDown">
                    <option selected>-- select color --</option>
                </select>
                <b><span class="text-danger" asp-validation-for="CorruCombination.ColorId"></span></b>
            </div>
        </div>

        <!-- Col for the Plys input field -->
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="mb-3 text-white">
                <!-- To add some margin between form-controls -->
                <label asp-for="CorruCombination.NoOfPlys" class="form-label">No of plys</label>
                <input type="number" class="form-control" asp-for="CorruCombination.NoOfPlys" placeholder="No of plys here">
                <b><span class="text-danger" asp-validation-for="CorruCombination.NoOfPlys"></span></b>
            </div>
        </div>

        <!-- Col for the table and add new row button -->
        <div class="col-12">
            <!-- Card -->
            <div class="card mb-3 shadow-sm border-primary text-white bg-dark">
                <div class="card-header text-bg-primary border-primary bg-primary align-middle">
                    <lable class="fw-bold">Combination Ratios</lable>
                </div>
                <div class="card-body text-white">
                    <blockquote class="row">
                        <table class="table text-white" style="min-width: 98%">
                            <thead class="align-middle">
                                <tr>
                                    <th scope="col">Placement</th>
                                    <th scope="col">GSM</th>
                                    <th scope="col">Item Category</th>
                                    <th class="text-center" scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                <tr>
                                    <td>
                                        <select class="form-select" asp-items="@Model.PlacementDropDown" asp-for="@Model.CorruCombination.CorruCombItemCatBridges[0].PlacementId">
                                            <option selected disabled>-- placement --</option>
                                        </select>
                                        <b><span class="text-danger" asp-validation-for="@Model.CorruCombination.CorruCombItemCatBridges[0].PlacementId"></span></b>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" asp-for="@Model.CorruCombination.CorruCombItemCatBridges[0].Gsm" placeholder="GSM" value="">
                                        <b><span class="text-danger" asp-validation-for="@Model.CorruCombination.CorruCombItemCatBridges[0].Gsm"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-items="@Model.ItemCategoryDropDown" asp-for="@Model.CorruCombination.CorruCombItemCatBridges[0].ItemCatId">
                                            <option selected disabled>-- item category --</option>
                                        </select>
                                        <b><span class="text-danger" asp-validation-for="@Model.CorruCombination.CorruCombItemCatBridges[0].ItemCatId"></span></b>
                                    </td>
                                    <td class="align-bottom">
                                        <div>
                                            <button type="button" class="btn btn-danger rounded del-this-row" onclick="self_remove(this)"><i class="fa-regular fa-trash-can"></i> Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="border-0" colspan="3" style="text-align: right;">
                                        Need To Add New Row?
                                    </td>
                                    <td class="border-0">
                                        <div class="d-flex justify-content-end">
                                            <button id="add-row" type="button" class="btn btn-primary"><i class="fa-regular fa-circle-plus"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </blockquote>
                </div>
            </div> <!-- End of the card -->
        </div><!-- End of the Col for the table and add new row button -->
        
        <!-- Section for the active checkbox and the submit button -->
        <div class="col-md-12">

            <!-- Row for the active checkbox -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="CorruCombination.IsActive">
                        <label class="form-check-label" asp-for="CorruCombination.IsActive">
                            <b>Active?</b>
                        </label>
                        <b><span class="text-danger" asp-validation-for="CorruCombination.IsActive"></span></b>
                    </div>
                </div>
            </div><!-- End of Row for the active checkbox -->
            <!-- Row for the submit button -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
                    </div>
                </div>
            </div>

        </div><!-- End of the Section for the active checkbox and the submit button -->

    </div>
</form>

@section Scripts{
    <script type="text/javascript">

        function self_remove(element) {
            if (element.closest('tbody').children.length > 1) {
                element.closest("tr").remove();
                reset_id_name_data_props();
            } else {
                alert("At least, there should be 1 table row!");
            }
            return;
        }

        function reset_id_name_data_props() {
            var table_rows = $('#table-body tr');

            table_rows.each(function (index, tr) {

                var first_select_box = $(tr).find('select:first');
                var second_select_box = $(tr).find('select:last');
                var input_number = $(tr).find('input');

                first_select_box.attr('id', 'CorruCombination_CorruCombItemCatBridges_' + index + '__PlacementId');
                first_select_box.attr('name', 'CorruCombination.CorruCombItemCatBridges[' + index + '].PlacementId');

                second_select_box.attr('id', 'CorruCombination_CorruCombItemCatBridges_' + index + '__ItemCatId');
                second_select_box.attr('name', 'CorruCombination.CorruCombItemCatBridges[' + index + '].ItemCatId');

                input_number.attr('id', 'CorruCombination_CorruCombItemCatBridges_' + index + '__Gsm');
                input_number.attr('name', 'CorruCombination.CorruCombItemCatBridges[' + index + '].Gsm');

            });

            $("form").removeData("validator").removeData("unobtrusiveValidation");
            //Parse the form again
            $.validator.unobtrusive.parse($("form"));
        }

        $(document).ready(function () {

            var first_items_list = $('#table-body').find('select:first').prop('innerHTML');
            var second_items_list = $('#table-body').find('select:last').prop('innerHTML');
            
            $('#add-row').click(function () {
                var row_count = document.getElementById('table-body').childElementCount;

                $('#table-body').append(
                    `<tr>
                        <td>
                            <select class="form-select" data-val="true" data-val-required="The PlacementId field is required." id="CorruCombination_CorruCombItemCatBridges_`+ row_count + `__PlacementId" name="CorruCombination.CorruCombItemCatBridges[` + row_count + `].PlacementId">
                            `+ first_items_list + `
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="CorruCombination.CorruCombItemCatBridges[`+ row_count + `].PlacementId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input type="number" class="form-control" placeholder="GSM" data-val="true" data-val-range="The Gsm field is required." data-val-range-max="2147483647" data-val-range-min="1" data-val-required="The Gsm field is required." id="CorruCombination_CorruCombItemCatBridges_`+ row_count + `__Gsm" name="CorruCombination.CorruCombItemCatBridges[` + row_count + `].Gsm" value="">
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="CorruCombination.CorruCombItemCatBridges[`+ row_count + `].Gsm" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <select class="form-select" data-val="true" data-val-range="The ItemCatId field is required." data-val-range-max="2147483647" data-val-range-min="1" data-val-required="The ItemCatId field is required." id="CorruCombination_CorruCombItemCatBridges_`+ row_count + `__ItemCatId" name="CorruCombination.CorruCombItemCatBridges[` + row_count + `].ItemCatId">
                            `+ second_items_list + `
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="CorruCombination.CorruCombItemCatBridges[`+ row_count + `].ItemCatId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td class="align-bottom">
                            <div>
                                <button type="button" class="btn btn-danger rounded del-this-row" onclick="self_remove(this)"><i class="fa-regular fa-trash-can"></i> Delete</button>
                            </div>
                        </td>
                    </tr>`
                );

                $("form").removeData("validator").removeData("unobtrusiveValidation");
                //Parse the form again
                $.validator.unobtrusive.parse($("form"));

            });

        });
    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}