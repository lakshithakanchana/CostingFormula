<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Costing Formula: KSPA</title>
    <link rel="icon" href="~/kspa-favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/fontawesome.css" rel="stylesheet">
    <link href="~/css/brands.css" rel="stylesheet">
    <link href="~/css/solid.css" rel="stylesheet">
    <link href="~/css/DataTable.css" rel="stylesheet">
    <link href="~/css/iziToast.min.css" rel="stylesheet">
    <!-- link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.12.1/css/jquery.dataTables.css" -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if(ViewData["StypeHRef1"] != null)
    {
        <link href="@Html.Raw(ViewData["StypeHRef1"])" rel="stylesheet" />
        <link href="@Html.Raw(ViewData["StypeHRef2"])" rel="stylesheet" />
    }
</head>
<body class="bg-dark">
    <main class="container-fluid text-white bg-dark">
        <header>
            <!-- Navigation bar -->
            <div class="row shadow shadow-intensity-xl kspa-shadow-primary mb-2">
                <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
                    <div class="container-fluid">
                        <a class="navbar-brand align-text-bottom" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-compass-drafting"></i> Costing Formula</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" >
                            <ul class="navbar-nav flex-grow-1">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <li class="nav-item d-none d-xxl-block">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> Home</a>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-globe"></i> Common Masters</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="Color" asp-action="Create"><i class="fa-solid fa-palette"></i> Color Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="Currency" asp-action="Create"><i class="fa-solid fa-coins"></i> Currency Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="Customer" asp-action="Create"><i class="fa-solid fa-users-viewfinder"></i> Customer Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="ItemCategory" asp-action="Create"><i class="fa-solid fa-sitemap"></i> Item Category Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="PrintType" asp-action="Create"><i class="fa-solid fa-print"></i> Print Type Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="SRepOrCoordinator" asp-action="Create"><i class="fa-solid fa-people-arrows"></i>Sales Rep &frasl; Coordinator Master</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-cube"></i> Corru Masters</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="BoxType" asp-action="Create"><i class="fa-solid fa-cube"></i> Box Type Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="Placement" asp-action="Create"><i class="fa-solid fa-arrows"></i> Placement Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="CorruCombination" asp-action="Create"><i class="fa-solid fa-blender"></i> Corru Combination Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="Route" asp-action="Create"><i class="fa fa-random"></i> Route Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="ReelSize" asp-action="Create"><i class="fa fa-database"></i> Reel Size Master</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-bag-shopping"></i> Poly Masters</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="BagType" asp-action="Create"><i class="fa-solid fa-bag-shopping"></i> Bag Type Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="Cylinder" asp-action="Create"><i class="fa-solid fa-database"></i> Cylinder Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="PolyMaterial" asp-action="Create"><i class="fa-solid fa-mound"></i> Poly Material Master</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="PolyCombination" asp-action="Create"><i class="fa-solid fa-blender"></i> Poly Combination Master</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-hand-holding-hand"></i> Transactions</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="CorruCosting" asp-action="Create" disabled><i class="fa-solid fa-compass-drafting"></i> New Quotation - Corru</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="PolyCosting" asp-action="Create"><i class="fa-solid fa-compass-drafting"></i> New Quotation - Poly</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="ExchangeRate" asp-action="Index"><i class="fa-solid fa-money-bill-trend-up"></i> Daily &frasl; Monthly Exchange Rate</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="ItemCategoryPrice" asp-action="Index"><i class="fa-solid fa-money-check-dollar"></i> Item Category Price Update</a></li>
                                            <li><a class="dropdown-item text-white" asp-area="" asp-controller="ItemCategoryPrice" asp-action="Create" asp-route-id="89"><i class="fa-solid fa-arrows-up-to-line"></i> Over Head Cost Update</a></li>
                                            @* <li><a class="dropdown-item text-white" asp-area="" asp-controller="Account" asp-action="CreateUser"><i class="fa-solid fa-user-plus"></i> Create New User</a></li> *@
                                        </ul>
                                    </li>
                                }
                            </ul>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <!-- Row for the footer -->
        <div class="row">
            <div class="col-md-12">
                <hr class="bg-primary border-2 border-primary" />
                <!-- Footer -->
                <div class="container-fluid">
                    <footer class="d-flex flex-wrap justify-content-between align-items-center py-3">

                        <p class="col-xl-4 mb-4 text-muted d-none d-xl-block">&copy;2022 Korean SPA Packaging (PVT) Ltd</p>

                        <ul class="nav col-md-12 col-xl-8 mb-4 justify-content-end">
                            <li class="nav-item"><a asp-action="index" asp-controller="Home" class="nav-link px-2 text-muted">Home</a></li>
                            <li class="nav-item"><a asp-action="Create" asp-controller="PolyCosting" class="nav-link px-2 text-muted">Poly Costing</a></li>
                            <li class="nav-item"><a asp-action="index" asp-controller="ExchangeRate" class="nav-link px-2 text-muted">Daily &frasl; Monthly Exchange Rate</a></li>
                            <li class="nav-item"><a asp-action="index" asp-controller="ItemCategoryPrice" class="nav-link px-2 text-muted">Item Category Price Update</a></li>
                            <li class="nav-item"><a asp-action="Create" asp-controller="ItemCategoryPrice" asp-route-id="89" class="nav-link px-2 text-muted">Over Head Cost Update</a></li>
                        </ul>

                        <p class="col-xl-12 mb-0 text-muted d-xl-none">&copy;2022 Korean SPA Packaging (PVT) Ltd</p>

                    </footer>
                </div>
            </div>
        </div><!-- End of row for the footer -->
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.2.3/js/dataTables.buttons.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.colVis.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
        <script src="~/js/iziToast.min.js"></script>
        @if (ViewBag.SuccessMessage != null)
        {
            <script type="text/javascript">
                $(document).ready(function () {
                    iziToast.success({
                        title: 'Ok',
                        message: '@ViewBag.SuccessMessage',
                        position: 'topRight'
                    });
                });
            </script>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <script type="text/javascript">
                $(document).ready(function () {
                    iziToast.error({
                        title: 'Error',
                        message: '@ViewBag.ErrorMessage',
                        position: 'topRight'
                    });
                });
            </script>
        }
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </main>
</body>
</html>
