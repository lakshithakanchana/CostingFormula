@model Costing_Formula___KSPA.Models.ExchangeRate;

@{
    ViewData["Title"] = "Daily / Monthly Exchange Rates - Edit";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Daily &frasl; Monthly Exchange Rates &ndash; Edit</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-circle-plus"></i> Add New</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Update">
    <div class="row">

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <!-- To add some margin between form-controls -->
                    <label asp-for="Currency.CurrencyCode" class="form-label">Currency short code</label>
                    <input type="text" class="form-control text-warning" asp-for="Currency.CurrencyCode" disabled>
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3  text-white">
                    <!-- mb-3 to add some margin between form-controls -->
                    <label asp-for="Currency.CurrencyDesc" class="form-label">Currency description</label>
                    <input type="text" class="form-control text-warning" asp-for="Currency.CurrencyDesc" disabled>
                </div>
            </div>
        </div>

        <!-- Active input filds area -->
        <div class="row">
            <input type="hidden" asp-for="CurrencyId" /> <!-- Hidden Input - Mandatory -->
            <div class="col-md-4">
                <div class="mb-3 text-white">
                    <label asp-for="ExchangeRateId" class="form-label">Ex.Rate id</label>
                    <input type="text" class="form-control" asp-for="ExchangeRateId" placeholder="System will generate" readonly>
                    <b><span class="text-danger" asp-validation-for="ExchangeRateId"></span></b>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 text-white">
                    <label asp-for="RateInLKR" class="form-label">Ex.Rate in LKR</label>
                    <input type="text" class="form-control" asp-for="RateInLKR">
                    <b><span class="text-danger" asp-validation-for="RateInLKR"></span></b>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 text-white">
                    <label asp-for="EffectiveFrom" class="form-label">Effective from date</label>
                    <input type="date" class="form-control" min="2000-01-01" max="2050-01-01" asp-for="EffectiveFrom"><!-- Max, Min date validation limited only to gui. Because App can handle multiple effective days. -->
                    <b><span class="text-danger" asp-validation-for="EffectiveFrom"></span></b>
                </div>
            </div>
        </div><!-- End of Active input filds area -->

        <!-- Section for the active checkbox and the submit button -->
        <div class="col-md-12">
            <!-- Row for the active checkbox -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsActive">
                        <label class="form-check-label" asp-for="IsActive">
                            <b>Active?</b>
                        </label>
                        <b><span class="text-danger" asp-validation-for="IsActive"></span></b>
                    </div>
                </div>
            </div><!-- End of Row for the active checkbox -->
            <!-- Row for the submit button -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
                    </div>
                </div>
            </div>
        </div><!-- End of the Section for the active checkbox and the submit button -->

    </div>

</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}