@model Costing_Formula___KSPA.Models.ViewModels.PolyCombinationVM;

@{
    ViewData["Title"] = "Poly Combination Master - Add New";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Poly Combination Master - Add New</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
            <a class="btn btn-secondary border border-2" asp-action="ImportFromCsv"><i class="fa-regular fa-upload"></i> Import From CSV</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Create">
    <div class="row">

        <!-- Everythine Except submit button and active checkbox -->
        <div class="col-12">

            <!-- Section 1: Row for the input fields and selection boxes -->
            <div class="row">

                <!-- Col for the poly combination id input field -->
                <div class="col-sm-6 col-lg-3">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label asp-for="PolyCombination.PolyCombId" class="form-label">Poly combination id</label>
                        <input type="text" class="form-control" asp-for="PolyCombination.PolyCombId" placeholder="System will generate" disabled>
                        <b><span class="text-danger" asp-validation-for="PolyCombination.PolyCombId"></span></b>
                    </div>
                </div>

                <!-- Col for the poly comb code input field -->
                <div class="col-sm-6 col-lg-3">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label asp-for="PolyCombination.PolyCombCode" class="form-label">Poly comb. code </label>
                        <input type="text" class="form-control" asp-for="PolyCombination.PolyCombCode" placeholder="As in Axpert">
                        <b><span class="text-danger" asp-validation-for="PolyCombination.PolyCombCode"></span></b>
                    </div>
                </div>

                <!-- Col for the color selection box -->
                <div class="col-sm-6 col-lg-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCombination.ColorId" class="form-label">Color</label>
                        <select class="form-select" asp-for="PolyCombination.ColorId" asp-items="@Model.ColorDropDown">
                            <option selected>-- select color --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="PolyCombination.ColorId"></span></b>
                    </div>
                </div>

                <!-- Col for the poly material selection box -->
                <div class="col-sm-6 col-lg-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="PolyCombination.PolyMaterialId" class="form-label">Poly material</label>
                        <select class="form-select" asp-for="PolyCombination.PolyMaterialId" asp-items="@Model.PolyMaterialDropDown">
                            <option selected>-- select poly material --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="PolyCombination.PolyMaterialId"></span></b>
                    </div>
                </div>

            </div><!-- Section 1: End of the Row for the input fields and selection boxes -->
            <!-- Section 2: Row for the input fields and selection boxes  -->
            <div class="row">
                <!-- Col for the Desc input field -->
                <div class="col-md-12">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label asp-for="PolyCombination.PolyCombDesc" class="form-label">Description</label>
                        <input type="text" class="form-control" asp-for="PolyCombination.PolyCombDesc" placeholder="Description here">
                        <b><span class="text-danger" asp-validation-for="PolyCombination.PolyCombDesc"></span></b>
                    </div>
                </div>
            </div><!-- Section 2: End of the Row for the input fields and selection boxes -->
            <!-- Section 3: Row for the input fields and selection boxes  -->
            <div class="row">
                <!-- Col for the special ref input field -->
                <div class="col-md-12">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label asp-for="PolyCombination.SpecialRef" class="form-label">Special ref</label>
                        <input type="text" class="form-control" asp-for="PolyCombination.SpecialRef" placeholder="Special ref here">
                        <b><span class="text-danger" asp-validation-for="PolyCombination.SpecialRef"></span></b>
                    </div>
                </div>
            </div><!-- Section 3: End of the Row for the input fields and selection boxes -->
            <!-- Row for the table and add new row button -->
            <div class="row">
                <div class="col-md-12">
                    <!-- Card -->
                    <div class="card mb-3 shadow-sm border-primary text-white bg-dark">
                        <div class="card-header text-bg-primary border-primary bg-primary align-middle">
                            <lable class="fw-bold">Combination Ratios</lable>
                        </div>
                        <div class="card-body text-white">
                            <blockquote class="row">
                                <table class="table text-white" style="min-width: 98%">
                                    <thead class="align-middle">
                                        <tr>
                                            <th scope="col">Item Category</th>
                                            <th scope="col">Percentage (%)</th>
                                            <th class="text-center" scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-body">
                                        <tr>
                                            <td>
                                                <select class="form-select" asp-items="@Model.ItemCategoryDropDown" asp-for="@Model.PolyCombination.PolyCombItemCatBridges[0].ItemCatId">
                                                    <option selected disabled>-- item category --</option>
                                                </select>
                                                <b><span class="text-danger" asp-validation-for="@Model.PolyCombination.PolyCombItemCatBridges[0].ItemCatId"></span></b>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" asp-for="@Model.PolyCombination.PolyCombItemCatBridges[0].Percentage" placeholder="Percentage">
                                                <b><span class="text-danger" asp-validation-for="@Model.PolyCombination.PolyCombItemCatBridges[0].Percentage"></span></b>
                                            </td>
                                            <td class="align-bottom">
                                                <div>
                                                    <button type="button" class="btn btn-danger rounded del-this-row" onclick="self_remove(this)"><i class="fa-regular fa-trash-can"></i> Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td class="border-0" colspan="2" style="text-align: right;">
                                                Need To Add New Row?
                                            </td>
                                            <td class="border-0">
                                                <div class="d-flex justify-content-end">
                                                    <button id="add-row" type="button" class="btn btn-primary"><i class="fa-regular fa-circle-plus"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </blockquote>
                        </div>
                    </div> <!-- End of the card -->
                </div>
            </div><!-- End of the Row for the table and add new row button -->

        </div><!-- End of the Everythine Except submit button and active checkbox -->

        <!-- Section for the active checkbox and the submit button -->
        <div class="col-md-12">

            <!-- Row for the active checkbox -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="PolyCombination.IsActive">
                        <label class="form-check-label" asp-for="PolyCombination.IsActive">
                            <b>Active?</b>
                        </label>
                        <b><span class="text-danger" asp-validation-for="PolyCombination.IsActive"></span></b>
                    </div>
                </div>
            </div><!-- End of Row for the active checkbox -->
            <!-- Row for the submit button -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
                    </div>
                </div>
            </div>

        </div><!-- End of the Section for the active checkbox and the submit button -->

    </div>
</form>

@section Scripts{
    <script type="text/javascript">

        function self_remove(element) {
            if (element.closest('tbody').children.length > 1) {
                element.closest("tr").remove();
                reset_id_name_data_props();
            } else {
                alert("At least, there should be 1 table row!");
            }
            return;
        }

        function reset_id_name_data_props() {
            var table_rows = $('#table-body tr');

            table_rows.each(function (index, tr) {

                var select_box = $(tr).find('select');
                var input_text = $(tr).find('input:text');

                select_box.attr('id', 'PolyCombination_PolyCombItemCatBridges_' + index + '__ItemCatId');
                select_box.attr('name', 'PolyCombination.PolyCombItemCatBridges[' + index + '].ItemCatId');

                input_text.attr('id', 'PolyCombination_PolyCombItemCatBridges_' + index + '__Percentage');
                input_text.attr('name', 'PolyCombination.PolyCombItemCatBridges[' + index + '].Percentage');

            });

            $("form").removeData("validator").removeData("unobtrusiveValidation");
            //Parse the form again
            $.validator.unobtrusive.parse($("form"));
        }

        $(document).ready(function () {
            
            var select_items_list = $('#table-body').find('select').prop('innerHTML');
            $('#add-row').click(function () {

                var row_count = document.getElementById('table-body').childElementCount;

                $('#table-body').append(
                    `<tr>
                        <td>
                            <select class="form-select" data-val="true" data-val-required="The ItemCatId field is required." id="PolyCombination_PolyCombItemCatBridges_`+ row_count + `__ItemCatId" name="PolyCombination.PolyCombItemCatBridges[` + row_count + `].ItemCatId">
                            `
                            + select_items_list +
                            `
                            </select>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="PolyCombination.PolyCombItemCatBridges[`+ row_count + `].ItemCatId" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input type="text" class="form-control" placeholder="Percentage" data-val="true" data-val-number="The field Percentage must be a number." data-val-range="Percentage is between 0% and 100%" data-val-range-max="100" data-val-range-min="0" data-val-required="The Percentage field is required." id="PolyCombination_PolyCombItemCatBridges_`+ row_count + `__Percentage" name="PolyCombination.PolyCombItemCatBridges[` + row_count + `].Percentage" value="">
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="PolyCombination.PolyCombItemCatBridges[`+ row_count + `].Percentage" data-valmsg-replace="true"></span></b>
                        </td>
                        <td class="align-bottom">
                            <div>
                                <button type="button" class="btn btn-danger rounded del-this-row" onclick="self_remove(this)"><i class="fa-regular fa-trash-can"></i> Delete</button>
                            </div>
                        </td>
                    </tr>`
                );

                $("form").removeData("validator").removeData("unobtrusiveValidation");
                //Parse the form again
                $.validator.unobtrusive.parse($("form"));

            });

        });
    </script>

    @{
    <partial name="_ValidationScriptsPartial" />
    }
}