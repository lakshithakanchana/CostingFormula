@model List<Costing_Formula___KSPA.Models.ViewModels.PolyCombinationVM>

@{
    ViewData["Title"] = "Poly Combination Master - Import CSV";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Poly Combination Master - Import CSV</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
            <a class="btn btn-secondary border border-2" asp-action="Create"><i class="fa-regular fa-circle-plus"></i> Add New</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <label for="formFile" class="form-label">Please choose the csv file to import from...</label>&nbsp;<label>(<a href="@Url.Content("~/import-templates/PolyCombinations.csv")">Click here to download the import template.</a>)</label>
    </div>
    <div class="col-sm-8">
        <div class="mb-3">
            <input class="form-control" type="file" id="upload_file" accept=".csv">
        </div>
    </div>
    <div class="col-sm-4">
        <div class="mb-3 d-grid gap-2">
            <button class="btn btn-primary" id="process_button"><i class="fa-regular fa-gears"></i> <b>Process</b></button>
        </div>
    </div>
    <div class="col-12">
        <hr class="bg-primary border-2 border-primary" />
    </div>
</div>

<div class="row">
    <form method="post" asp-action="ImportFromCsv">

        <div class="col-md-12">
            <!-- Card -->
            <div class="card mb-3 shadow-sm border-primary text-white bg-dark">
                <div class="card-header text-bg-primary border-primary bg-primary align-middle">
                    <lable class="fw-bold">Proceed CSV...</lable>
                </div>
                <div class="card-body text-white">
                    <blockquote class="row">
                        <table class="data-table table text-white" style="min-width: 98%">
                            <thead>
                                <tr>
                                    <th class="text-nowrap" scope="col">Poly comb. code</th>
                                    <th class="text-nowrap" scope="col">Color</th>
                                    <th class="text-nowrap" scope="col">Poly meterial</th>
                                    <th class="text-nowrap" scope="col">Description</th>
                                    <th class="text-nowrap" scope="col">Special ref</th>
                                    <th class="text-nowrap" scope="col">Item Category</th>
                                    <th class="text-nowrap" scope="col">Percentage (&percnt;)</th>
                                    <th class="text-nowrap" scope="col">Active&quest;</th>
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                <tr>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].PolyCombination.PolyCombCode" placeholder="As in Axpert">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.PolyCombCode"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].PolyCombination.ColorId" asp-items="@Model[0].ColorDropDown">
                                            <option selected>-- select color --</option>
                                        </select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.ColorId"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-for="@Model[0].PolyCombination.PolyMaterialId" asp-items="@Model[0].PolyMaterialDropDown">
                                            <option selected>-- select poly material --</option>
                                        </select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.PolyMaterialId"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].PolyCombination.PolyCombDesc" placeholder="Description here">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.PolyCombDesc"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].PolyCombination.SpecialRef" placeholder="Special ref here">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.SpecialRef"></span></b>
                                    </td>
                                    <td>
                                        <select class="form-select" asp-items="@Model[0].ItemCategoryDropDown" asp-for="@Model[0].PolyCombination.PolyCombItemCatBridges[0].ItemCatId">
                                            <option selected disabled>-- item category --</option>
                                        </select>
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.PolyCombItemCatBridges[0].ItemCatId"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].PolyCombination.PolyCombItemCatBridges[0].Percentage" placeholder="Percentage">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.PolyCombItemCatBridges[0].Percentage"></span></b>
                                    </td>
                                    <td>
                                        <input class="form-check-input" asp-for="@Model[0].PolyCombination.IsActive">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].PolyCombination.IsActive"></span></b>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </blockquote>
                </div>
            </div> <!-- End of the card -->
        </div>
        <div class="col-12">
            <div class="d-grid gap-2">
                <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
            </div>
        </div>

    </form>
</div>

@section Scripts{
    <script src="~/lib/papaparse/dist/papaparse.min.js"></script>

    <script type="text/javascript">

        // Global Variables
        const COLOR_JSON_ARRAY = @Html.Raw(ViewBag.colorsJsonStr);
        const POLY_MATERIAL_JSON_ARRAY = @Html.Raw(ViewBag.polyMaterialsJsonStr);
        const ITEM_CATEGORY_JSON_ARRAY = @Html.Raw(ViewBag.itemCategoriesJsonStr);

        $(document).ready(function () {
            document.getElementById('table-body').innerHTML = '';
        });

        const process_btn = document.getElementById('process_button')
            .addEventListener('click', () => {
                Papa.parse(document.getElementById('upload_file').files[0], {
                    download: true,
                    header: true,
                    skipEmptyLines: true,
                    complete: function (results) {
                        document.getElementById('table-body').innerHTML = '';
                        add_input_rows(results.data);
                    }
                });
            });

        function add_input_rows(poly_combinations) {
            var html_rows = '';
            for (var i = 0; i < poly_combinations.length; i++) {

                var poly_combination = poly_combinations[i];

                var row_count = i;
                if (typeof poly_combination.Code === 'undefined') {
                    alert('\"Code\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.Color === 'undefined') {
                    alert('\"Color\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.PolyMaterial === 'undefined') {
                    alert('\"PolyMaterial\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.Description === 'undefined') {
                    alert('\"Description\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.SpecialRef === 'undefined') {
                    alert('\"SpecialRef\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.ItemCategory === 'undefined') {
                    alert('\"ItemCategory\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.Percentage === 'undefined') {
                    alert('\"Percentage\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof poly_combination.Active === 'undefined') {
                    alert('\"Active\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var is_checked_active;
                if (poly_combination.Active.toLowerCase() == 't' || poly_combination.Active.toLowerCase() == 'true' || poly_combination.Active == '1') {
                    is_checked_active = 'checked';
                } else if (poly_combination.Active.toLowerCase() == 'f' || poly_combination.Active.toLowerCase() == 'false' || poly_combination.Active == '0') {
                    is_checked_active = '';
                } else {
                    alert(poly_combination.Active + ' is not valid value for the column \"Active\"! Acceptable only \"True\" or \"False\" or \"1\" or \"0\" words. Please correct and process again');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var color_id;
                var color_obj = get_object_by_text(COLOR_JSON_ARRAY, poly_combination.Color);
                if (color_obj === null)
                    color_id = null;
                else
                    color_id = color_obj.Id
                if (color_id === null) {
                    alert(poly_combination.Color + " is not available inside the color master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var poly_mat_id;
                var poly_mat_obj = get_object_by_text(POLY_MATERIAL_JSON_ARRAY, poly_combination.PolyMaterial);
                if (poly_mat_obj === null)
                    poly_mat_id = null;
                else
                    poly_mat_id = poly_mat_obj.Id
                if (poly_mat_id === null) {
                    alert(poly_combination.PolyMaterial + " is not available inside the poly material master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var item_cat_id;
                var item_cat_obj = get_object_by_text(ITEM_CATEGORY_JSON_ARRAY, poly_combination.ItemCategory);
                if (item_cat_obj === null)
                    item_cat_id = null;
                else
                    item_cat_id = item_cat_obj.Id
                if (item_cat_id === null) {
                    alert(poly_combination.ItemCategory + " is not available inside the item category master or inactive! Please contact your admin...");
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                html_rows +=
                    `
                        <tr>
                            <td>
                                <input type="text" class="form-control" placeholder="As in Axpert" data-val="true"
                                        data-val-required="The PolyCombCode field is required." id="z` + row_count + `__PolyCombination_PolyCombCode"
                                        name="[` + row_count + `].PolyCombination.PolyCombCode" value="` + poly_combination.Code + `">
                                <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].PolyCombination.PolyCombCode"
                                    data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <select class="form-select" data-val="true" data-val-required="The ColorId field is required."
                                    id="z` + row_count + `__PolyCombination_ColorId" name="[` + row_count + `].PolyCombination.ColorId">
                                    <option value="` + color_id + `" selected>` + poly_combination.Color + `</option>
                                </select>
                                <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].PolyCombination.ColorId"
                                    data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <select class="form-select" data-val="true" data-val-required="The PolyMaterialId field is required."
                                    id="z` + row_count + `__PolyCombination_PolyMaterialId" name="[` + row_count + `].PolyCombination.PolyMaterialId">
                                    <option value="` + poly_mat_id + `" selected>` + poly_combination.PolyMaterial + `</option>
                                </select>
                                <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].PolyCombination.PolyMaterialId"
                                        data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <input type="text" class="form-control" placeholder="Description here" data-val="true"
                                    data-val-required="The PolyCombDesc field is required." id="z` + row_count + `__PolyCombination_PolyCombDesc"
                                    name="[` + row_count + `].PolyCombination.PolyCombDesc" value="` + poly_combination.Description + `">
                                <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].PolyCombination.PolyCombDesc"
                                    data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <input type="text" class="form-control" placeholder="Special ref here" id="z` + row_count + `__PolyCombination_SpecialRef"
                                    name="[` + row_count + `].PolyCombination.SpecialRef" value="` + poly_combination.SpecialRef + `">
                                <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].PolyCombination.SpecialRef"
                                    data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <select class="form-select" data-val="true" data-val-range="The ItemCatId field is required."
                                    data-val-range-max="2147483647" data-val-range-min="1" data-val-required="The ItemCatId field is required."
                                    id="z` + row_count + `__PolyCombination_PolyCombItemCatBridges_0__ItemCatId"
                                    name="[` + row_count + `].PolyCombination.PolyCombItemCatBridges[0].ItemCatId">
                                        <option value="` + item_cat_id + `" selected>` + poly_combination.ItemCategory + `</option>
                                </select>
                                <b><span class="text-danger field-validation-valid"
                                        data-valmsg-for="[` + row_count + `].PolyCombination.PolyCombItemCatBridges[0].ItemCatId"
                                        data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <input type="text" class="form-control" placeholder="Percentage" data-val="true"
                                    data-val-number="The field Percentage must be a number." data-val-range="Percentage is between 0% and 100%"
                                    data-val-range-max="100" data-val-range-min="0" data-val-required="The Percentage field is required."
                                        id="z` + row_count + `__PolyCombination_PolyCombItemCatBridges_0__Percentage"
                                        name="[` + row_count + `].PolyCombination.PolyCombItemCatBridges[0].Percentage" value="` + poly_combination.Percentage + `">
                                <b><span class="text-danger field-validation-valid"
                                        data-valmsg-for="[` + row_count + `].PolyCombination.PolyCombItemCatBridges[0].Percentage"
                                        data-valmsg-replace="true"></span></b>
                            </td>
                            <td>
                                <input class="form-check-input" type="checkbox" data-val="true"
                                    data-val-required="The IsActive field is required." id="z` + row_count + `__PolyCombination_IsActive"
                                    name="[` + row_count + `].PolyCombination.IsActive" value="true" ` + is_checked_active + `>
                                <b><span class="text-danger field-validation-valid" data-valmsg-for="[` + row_count + `].PolyCombination.IsActive"
                                    data-valmsg-replace="true"></span></b>
                            </td>
                        </tr>
                    `;

            } // for loop end

            $('#table-body').append(html_rows);
            $("form").removeData("validator").removeData("unobtrusiveValidation");
            //Parse the form again
            $.validator.unobtrusive.parse($("form"));
        }

        function get_object_by_text(json_array, text) {
            for (i = 0; i < json_array.length; i++) {
                if (json_array[i].Text.toLowerCase() == text.toLowerCase())
                    return json_array[i];
            }
            return null;
        }

    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
