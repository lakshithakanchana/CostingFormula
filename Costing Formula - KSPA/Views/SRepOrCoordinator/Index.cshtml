@model IEnumerable<Costing_Formula___KSPA.Models.SRepOrCoordinator>;

@{
    ViewData["Title"] = "Sales Rep &frasl; Coordinator Master - List View";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Sales Rep &frasl; Coordinator Master - List View</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4 btn-group" role="group">
            <a class="btn btn-primary" asp-action="Create"><i class="fa-regular fa-circle-plus"></i> New</a>
            <a class="btn btn-primary" asp-action="ImportFromCsv"><i class="fa-regular fa-upload"></i> Import From CSV</a>
            <button type="button" class="btn btn-primary"><i class="fa-regular fa-download"></i> Download XL</button>
        </div>
    </div>
</div>

@if (Model.Count() > 0)
{
    //If there are 1 or more SROCs to show
    <div class="row">
        <div class="col-md-12">
            <!-- Card -->
            <div class="card mb-3 shadow-sm border-primary text-white bg-dark">
                <div class="card-header text-bg-primary border-primary bg-primary align-middle">
                    <lable class="fw-bold">List View</lable>
                </div>
                <div class="card-body text-white">
                    <blockquote class="row">
                        <table class="data-table table text-white" style="min-width: 98%">
                            <thead>
                                <tr>
                                    <th class="text-nowrap" scope="col">ID</th>
                                    <th class="text-nowrap" scope="col">Short Name</th>
                                    <th class="text-nowrap" scope="col">Contact Number</th>
                                    <th class="text-nowrap" scope="col">Email Address</th>
                                    <th class="text-nowrap" scope="col">Representative&quest;</th>
                                    <th class="text-nowrap" scope="col">Coordinator&quest;</th>
                                    <th class="text-nowrap" scope="col">Active&quest;</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sROC in Model)
                                {
                                    <tr>
                                        <td class="text-nowrap">@sROC.SrocId</td>
                                        <td class="text-nowrap"><a asp-action="Update" asp-route-id="@sROC.SrocId">@sROC.SrocName</a></td>
                                        <td class="text-nowrap">@sROC.SrocContact</td>
                                        <td class="text-nowrap">@sROC.SrocEmail</td>
                                        <td class="text-nowrap">@sROC.IsReprecentative</td>
                                        <td class="text-nowrap">@sROC.IsCoordinator</td>
                                        <td class="text-nowrap">@sROC.IsActive</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </blockquote>
                </div>
            </div> <!-- End of the card -->
        </div>
    </div>
}
else
{
    //If there are no SROCs to show
    <div class="row">
        <div class="col-md-12">
            <h2>There are no sales representatives or coordinators been added yet!</h2>
            <p>
                Add one?
                <a class="btn btn-primary" asp-action="Create">
                    <i class="fa-regular fa-circle-plus"></i>
                </a>
            </p>
        </div>
    </div>
}

@section Scripts{
    @{
    <partial name="_ValidationScriptsPartial" />
    }
}
