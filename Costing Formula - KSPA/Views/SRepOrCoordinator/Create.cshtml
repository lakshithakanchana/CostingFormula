@model Costing_Formula___KSPA.Models.SRepOrCoordinator;

@{
    ViewData["Title"] = "Sales Rep / Coordinator Master - Add New Rep / Coordinator";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Sales Rep &frasl; Coordinator Master - Add New Rep &frasl; Coordinator</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
            <a class="btn btn-secondary border border-2" asp-action="ImportFromCsv"><i class="fa-regular fa-upload"></i> Import From CSV</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="mb-4 text-danger" asp-validation-summary="All">
            <!-- Validation Summary Will Be Here -->
        </div>
    </div>
</div>

<form method="post" asp-action="Create">
    <div class="row">

        <!-- Section EXCEPT for the active checkbox and the submit button -->
        <div class="col-md-12">

            <!-- SROC Id, SROC Name Input Fields -->
            <div class="row">
                <div class="col-sm-3">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="SrocId" class="form-label">Sales Rep &frasl; Coordinator id</label>
                        <input type="text" class="form-control" asp-for="SrocId" placeholder="System will generate for you" disabled>
                        <b><span class="text-danger" asp-validation-for="SrocId"></span></b>
                    </div>
                </div>
                <div class="col-sm-9">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="SrocName" class="form-label">Sales Rep &frasl; Coordinator short name</label>
                        <input type="text" class="form-control" asp-for="SrocName">
                        <b><span class="text-danger" asp-validation-for="SrocName"></span></b>
                    </div>
                </div>
            </div><!-- End of SROC Id, SROC Name Input Fields -->

            <!-- Rep/Coordinator Check boxes -->
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-check mb-3"><!-- To add some margin between form-controls -->
                        <input class="form-check-input" type="checkbox" asp-for="IsReprecentative">
                        <label class="form-check-label" asp-for="IsReprecentative">
                            Sales Rep&quest;
                        </label>
                        <b><span class="text-danger" asp-validation-for="IsReprecentative"></span></b>
                    </div>
                </div>
                <div class="col-sm-9">
                    <div class="form-check mb-3"><!-- To add some margin between form-controls -->
                        <input class="form-check-input" type="checkbox" asp-for="IsCoordinator">
                        <label class="form-check-label" asp-for="IsCoordinator">
                            Sales Coordinator&quest;
                        </label>
                        <b><span class="text-danger" asp-validation-for="IsCoordinator"></span></b>
                    </div>
                </div>
            </div><!-- End of Rep/Coordinator Check boxess -->

            <!-- SROC Contact, Email Input Fields -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="SrocContact" class="form-label">Sales Rep &frasl; Coordinator contact number</label>
                        <input type="tel" class="form-control" asp-for="SrocContact">
                        <b><span class="text-danger" asp-validation-for="SrocContact"></span></b>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="SrocEmail" class="form-label">Sales Rep &frasl; Coordinator email address</label>
                        <input type="email" class="form-control" asp-for="SrocEmail">
                        <b><span class="text-danger" asp-validation-for="SrocEmail"></span></b>
                    </div>
                </div>
            </div><!-- End of SROC Contact, Email Input Fields -->

        </div><!-- Section EXCEPT for the active checkbox and the submit button -->

        <!-- Section for the active checkbox and the submit button -->
        <div class="col-md-12">

            <!-- Row for the active checkbox -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsActive">
                        <label class="form-check-label" asp-for="IsActive">
                            <b>Active?</b>
                        </label>
                        <b><span class="text-danger" asp-validation-for="IsActive"></span></b>
                    </div>
                </div>
            </div><!-- End of Row for the active checkbox -->
            <!-- Row for the submit button -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
                    </div>
                </div>
            </div>

        </div><!-- End of the Section for the active checkbox and the submit button -->

    </div>
</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}