@model List<Costing_Formula___KSPA.Models.ItemCategory>

@{
    ViewData["Title"] = "Item Category Master - Import CSV";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Item Category Master - Import CSV</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Create"><i class="fa-regular fa-circle-plus"></i> Add New</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <label for="formFile" class="form-label">Please choose the csv file to import from...</label>&nbsp;<label>(<a href="@Url.Content("~/import-templates/ItemCategory.csv")">Click here to download the import template.</a>)</label>
    </div>
    <div class="col-sm-8">
        <div class="mb-3">
            <input class="form-control" type="file" id="upload_file" accept=".csv">
        </div>
    </div>
    <div class="col-sm-4">
        <div class="mb-3 d-grid gap-2">
            <button class="btn btn-primary" id="process_button"><i class="fa-regular fa-gears"></i> <b>Process</b></button>
        </div>
    </div>
    <div class="col-12">
        <hr class="bg-primary border-2 border-primary" />
    </div>
</div>

<div class="row">
    <form method="post" asp-action="ImportFromCsv">

        <div class="col-md-12">
            <!-- Card -->
            <div class="card mb-3 shadow-sm border-primary text-white bg-dark">
                <div class="card-header text-bg-primary border-primary bg-primary align-middle">
                    <lable class="fw-bold">Proceed CSV...</lable>
                </div>
                <div class="card-body text-white">
                    <blockquote class="row">
                        <table class="data-table table text-white" style="min-width: 98%">
                            <thead>
                                <tr>
                                    <th class="text-nowrap" scope="col">Item Category Code</th>
                                    <th class="text-nowrap" scope="col">Description</th>
                                    <th class="text-nowrap" scope="col">Is Poly Combination</th>
                                    <th class="text-nowrap" scope="col">Is Corru Combination</th>
                                    <th class="text-nowrap" scope="col">Active&quest;</th>
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                <tr>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].ItemCategoryCode" placeholder="Item category code (same as in Axpert)">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].ItemCategoryCode"></span></b>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" asp-for="@Model[0].ItemCategoryDesc" placeholder="Item category description here">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].ItemCategoryDesc"></span></b>
                                    </td>
                                    <td>
                                        <input class="form-check-input" type="checkbox" asp-for="@Model[0].IsPolyComb">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].IsPolyComb"></span></b>
                                    </td>
                                    <td>
                                        <input class="form-check-input" type="checkbox" asp-for="@Model[0].IsCorruComb">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].IsCorruComb"></span></b>
                                    </td>
                                    <td>
                                        <input class="form-check-input" asp-for="@Model[0].IsActive">
                                        <b><span class="text-danger" asp-validation-for="@Model[0].IsActive"></span></b>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </blockquote>
                </div>
            </div> <!-- End of the card -->
        </div>
        <div class="col-12">
            <div class="d-grid gap-2">
                <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
            </div>
        </div>

    </form>
</div>

@section Scripts{
    <script src="~/lib/papaparse/dist/papaparse.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            document.getElementById('table-body').innerHTML = '';
        });

        const process_btn = document.getElementById('process_button')
            .addEventListener('click', () => {
                Papa.parse(document.getElementById('upload_file').files[0], {
                    download: true,
                    header: true,
                    skipEmptyLines: true,
                    complete: function (results) {
                        document.getElementById('table-body').innerHTML = '';
                        add_input_rows(results.data);
                    }
                });
            });

        function add_input_rows(item_cats) {
            for (var i = 0; i < item_cats.length; i++) {

                var item_cat = item_cats[i];

                var row_count = document.getElementById('table-body').childElementCount;

                if (typeof item_cat.Code === 'undefined') {
                    alert('\"Code\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof item_cat.ItemDescription === 'undefined') {
                    alert('\"ItemDescription\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof item_cat.PolyComb === 'undefined') {
                    alert('\"PolyComb\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof item_cat.CorruComb === 'undefined') {
                    alert('\"CorruComb\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                if (typeof item_cat.Active === 'undefined') {
                    alert('\"Active\" column is not available inside the imported csv file!');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                var is_poly_comb_checked;
                if (item_cat.PolyComb.toLowerCase() == 'true' || item_cat.PolyComb == '1') {
                    is_poly_comb_checked = 'checked';
                } else if (item_cat.PolyComb.toLowerCase() == 'false' || item_cat.PolyComb == '0') {
                    is_poly_comb_checked = '';
                } else {
                    alert(item_cat.PolyComb + ' is not valid value for the column \"PolyComb\"! Please correct and process again');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                var is_corru_comb_checked;
                if (item_cat.CorruComb.toLowerCase() == 'true' || item_cat.CorruComb == '1') {
                    is_corru_comb_checked = 'checked';
                } else if (item_cat.CorruComb.toLowerCase() == 'false' || item_cat.CorruComb == '0') {
                    is_corru_comb_checked = '';
                } else {
                    alert(item_cat.CorruComb + ' is not valid value for the column \"CorruComb\"! Please correct and process again');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }
                var is_active_checked;
                if (item_cat.Active.toLowerCase() == 'true' || item_cat.Active == '1') {
                    is_active_checked = 'checked';
                } else if (item_cat.Active.toLowerCase() == 'false' || item_cat.Active == '0') {
                    is_active_checked = '';
                } else {
                    alert(item_cat.Active + ' is not valid value for the column \"Active\"! Please correct and process again');
                    document.getElementById('table-body').innerHTML = '';
                    return;
                }

                $('#table-body').append(
                    `
                    <tr>
                        <td>
                            <input type="text" class="form-control" placeholder="Item category code (same as in Axpert)" data-val="true" data-val-required="The ItemCategoryCode field is required." id="z`+ row_count + `__ItemCategoryCode" name="[` + row_count + `].ItemCategoryCode" value="` + item_cat.Code + `">
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].ItemCategoryCode" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input type="text" class="form-control" placeholder="Item category description here" data-val="true" data-val-required="The ItemCategoryDesc field is required." id="z`+ row_count + `__ItemCategoryDesc" name="[` + row_count + `].ItemCategoryDesc" value="` + item_cat.ItemDescription + `">
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].ItemCategoryDesc" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input class="form-check-input" type="checkbox" data-val="true" data-val-required="The IsPolyComb field is required." id="z`+ row_count + `__IsPolyComb" name="[` + row_count + `].IsPolyComb" value="true" ` + is_poly_comb_checked + `>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].IsPolyComb" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input class="form-check-input" type="checkbox" data-val="true" data-val-required="The IsCorruComb field is required." id="z`+ row_count + `__IsCorruComb" name="[` + row_count + `].IsCorruComb" value="true" ` + is_corru_comb_checked + `>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].IsCorruComb" data-valmsg-replace="true"></span></b>
                        </td>
                        <td>
                            <input class="form-check-input" type="checkbox" data-val="true" data-val-required="The IsActive field is required." id="z`+ row_count + `__IsActive" name="[` + row_count + `].IsActive" value="true" ` + is_active_checked + `>
                            <b><span class="text-danger field-validation-valid" data-valmsg-for="[`+ row_count + `].IsActive" data-valmsg-replace="true"></span></b>
                        </td>
                    </tr>
                    `
                );
                $("form").removeData("validator").removeData("unobtrusiveValidation");
                //Parse the form again
                $.validator.unobtrusive.parse($("form"));
            }
        }

    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
