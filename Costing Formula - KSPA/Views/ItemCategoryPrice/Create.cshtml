@model Costing_Formula___KSPA.Models.ItemCategoryPrice;

@{
    ViewData["Title"] = "Item Category Price Update";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Item Category Price Update</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-secondary border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Create">
    <div class="row">
        <div class="col-md-12">

            <div class="row">

                <!-- Col for the ISCP Id -->
                <div class="col-md-4">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label class="form-label" asp-for="IcpId">ICP id</label>
                        <input class="form-control text-warning fw-bold" type="text" asp-for="IcpId" placeholder="System will generate for you" disabled />
                        <b><span class="text-danger" asp-validation-for="IcpId"></span></b>
                    </div>
                </div>

                <input type="hidden" asp-for="ItemCatId" /> <!-- Hidden Input -->

                <!-- Col for the Item Category Code -->
                <div class="col-md-8">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label class="form-label" asp-for="ItemCategory.ItemCategoryCode">Item Category Code <span class="text-warning fw-bold">(As in Axpert)</span></label>
                        <input class="form-control" type="text" asp-for="ItemCategory.ItemCategoryCode" disabled/>
                        <b><span class="text-danger" asp-validation-for="ItemCategory.ItemCategoryCode"></span></b>
                    </div>
                </div>

                <!-- Col for the Item Category Desc -->
                <div class="col-md-12">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label class="form-label" asp-for="ItemCategory.ItemCategoryDesc">Item category description</label>
                        <input class="form-control" type="text" asp-for="ItemCategory.ItemCategoryDesc" disabled/>
                        <b><span class="text-danger" asp-validation-for="ItemCategory.ItemCategoryDesc"></span></b>
                    </div>
                </div>

                <!-- Col for the Unit Price col -->
                <div class="col-md-4">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label class="form-label" asp-for="UnitPrice">Unit Price</label>
                        <input class="form-control" type="text" asp-for="UnitPrice" />
                        <b><span class="text-danger" asp-validation-for="UnitPrice"></span></b>
                    </div>
                </div>

                <!-- Col for the duty per unit in cm -->
                <div class="col-md-4">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label class="form-label" asp-for="UnitDuty">Duty <span class="text-warning">per unit</span></label>
                        <input class="form-control" type="text" asp-for="UnitDuty" />
                        <b><span class="text-danger" asp-validation-for="UnitDuty"></span></b>
                    </div>
                </div>

                <!-- Col for the No of pieces -->
                <div class="col-md-4">
                    <div class="mb-3  text-white">
                        <!-- mb-3 to add some margin between form-controls -->
                        <label class="form-label" asp-for="DateUpdated">Date effective from</label>
                        <input type="date" class="form-control" min="@(DateTime.Today.ToString("yyyy-MM-dd"))" max="@(DateTime.Today.ToString("yyyy-MM-dd"))" asp-for="DateUpdated">
                        <b><span class="text-danger" asp-validation-for="DateUpdated"></span></b>
                    </div>
                </div>

            </div>

            <!-- Row for the active checkbox -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsActive" checked>
                        <label class="form-check-label" asp-for="IsActive">
                            <b>Active?</b>
                        </label>
                        <b><span class="text-danger" asp-validation-for="IsActive"></span></b>
                    </div>
                </div>
            </div><!-- End of Row for the active checkbox -->
            <!-- Row for the submit button -->
            <div class="row">
                <div class="col-md-12">
                    <hr class="bg-primary border-2 border-primary" />
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit"><i class="fa-regular fa-floppy-disk"></i> <b>Save</b></button>
                    </div>
                </div>
            </div>

        </div>
    </div>

</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}