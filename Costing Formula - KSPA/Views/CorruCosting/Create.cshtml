@model Costing_Formula___KSPA.Models.ViewModels.CorruCostingVM

@{
    ViewData["Title"] = "Create New Quotation";
    ViewData["StypeHRef1"] = "https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css";
    ViewData["StypeHRef2"] = "https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css";
}

<!-- Row for the header level 1 -->
<div class="row">
    <div class="col-md-12">
        <h1>Create New Quotation - Corrugation</h1>
        <hr class="bg-primary border-2 border-primary" />
        <br />
    </div>
</div><!-- End of the row for the header level 1 -->

<!-- Ribbon for buttons -->
<div class="row">
    <div class="col-md-12">
        <div class="mb-4">
            <a class="btn btn-primary btn-outline-light border border-2" asp-action="Index"><i class="fa-regular fa-list-ol"></i> List View</a>
        </div>
    </div>
</div>

@if (!Html.ViewData.ModelState.IsValid)
{
    <div class="row">
        <div class="col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-md-3">
            <!-- Validation Summary Will Be Here -->
            <div class="card text-danger mb-3 border border-danger border-2" style="background-color: rgba(255, 0, 0, 0.1);">
                <div class="card-header fw-bold">There are some errors with the data, you entered!</div>
                <div class="card-body validation-summary" asp-validation-summary="All">
                </div>
            </div>
        </div>
    </div>
}

<form method="post" asp-action="Create">
    <div class="row">

        <div class="col-md-12 mt-3">
            <h2 class="h5"><u>Document Specification Section</u></h2>
        </div>

        <input type="hidden" asp-for="CorruCosting.CorruCostingId" />

        <!-- Doc date -->
        <div class="col-6 col-md-3">
            <div class="mb-3">
                <!-- To add some margin between form-controls -->
                <label asp-for="CorruCosting.DateCreated" class="form-label">Doc date &ast;</label>
                <input type="date" class="form-control" asp-for="CorruCosting.DateCreated" placeholder="Doc date" min=@(DateTime.Today.ToString("yyyy-MM-dd")) max=@(DateTime.Today.ToString("yyyy-MM-dd")) tabindex="01">
                <b><span class="text-danger" asp-validation-for="CorruCosting.DateCreated"></span></b>
            </div>
        </div>

        <!-- Quotation No -->
        <div class="col-6 col-md-3 d-none">
            <div class="mb-3">
                <!-- To add some margin between form-controls -->
                <label asp-for="CorruCosting.CorruCostingCode" class="form-label">Quatation No</label>
                <input type="text" class="form-control" asp-for="CorruCosting.CorruCostingCode" placeholder="System will generate for you" disabled>
                <b><span class="text-danger" asp-validation-for="CorruCosting.CorruCostingCode"></span></b>
            </div>
        </div>

        <!-- Company Name -->
        <div class="col-6 col-md-6">
            <div class="mb-3 text-white">
                <!-- To add some margin between form-controls -->
                <label asp-for="CorruCosting.CompanyId" class="form-label">Company name &ast;</label>
                <select class="form-select"
                        asp-for="CorruCosting.CompanyId"
                        asp-items="@Model.CompanyDropDown"
                        tabindex="02" >
                </select>
                <b><span class="text-danger" asp-validation-for="CorruCosting.CompanyId"></span></b>
            </div>
        </div>

        <div class="col-12">
            <hr class="bg-primary border-2 border-primary" />
        </div>

        <div class="col-md-12 mt-3">
            <h2 class="h5"><u>Customer Detail Section</u></h2>
        </div>

        <div class="col-12">
            <div class="row">
                <!-- customer detail except address -->
                <div class="col-md-6">
                    <div class="row">
                        <!-- Customer Name -->
                        <div class="col-md-12">
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="CorruCosting.CustomerId" class="form-label">Customer name &ast;</label>
                                <select class="select2 form-select"
                                        asp-for="CorruCosting.CustomerId"
                                        asp-items="@Model.CustomerDropDown"
                                        tabindex="3">
                                    <option selected>-- select customer --</option>
                                </select>
                                <b><span class="text-danger" asp-validation-for="CorruCosting.CustomerId"></span></b>
                            </div>
                        </div>
                    </div>
                </div><!-- End of customer derail except address -->
                <!-- Customer Address Text Area -->
                <div class="col-md-6">
                    <div class="row">
                        <!-- Customer Type -->
                        <div class="col-md-4">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="cusTypeInputF" class="form-label">Cus. type</label>
                                <input type="text" class="form-control" id="cusTypeInputF" placeholder="Customer type" disabled>
                            </div>
                        </div>

                        <!-- Customer Currency (Code) -->
                        <div class="col-6 col-md-4">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="cusCurrencyInputF" class="form-label">Cus. currency</label>
                                <input type="text" class="form-control" id="cusCurrencyInputF" placeholder="Customer currency" disabled>
                            </div>
                        </div>

                        <!-- Exchange rate in LKR (Code) -->
                        <div class="col-6 col-md-4">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="exRateInputF" class="form-label">Exchange rate</label>
                                <input type="text" class="form-control" id="exRateInputF" placeholder="Exchange rate" disabled>
                            </div>
                        </div>

                        <!-- Delivery address -->
                        <div class="col-12 d-none">
                            <div class="form-group mb-3 text-white">
                                <label asp-for="CorruCosting.DeliveryAddress" class="form-label">Delivery address &ast;</label>
                                <textarea class="form-control" asp-for="CorruCosting.DeliveryAddress" rows="4" tabindex="4"></textarea>
                                <b><span class="text-danger" asp-validation-for="CorruCosting.DeliveryAddress"></span></b>
                            </div>
                        </div>
                    </div>
                </div><!-- End of Customer Address Text Area -->
            </div>
        </div>

        <!-- Corru Combination Section -->
        <div class="col-md-12">
            <div class="row">

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Corru Combination Section</u></h2>
                </div>

                <!-- Color -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label for="colorsSelectBx" class="form-label"><span class="text-warning">Filter by</span> color</label>
                        <select class="form-select"
                                id="colorsSelectBx"
                                asp-items="@Model.ColorDropDown"
                                tabindex="5">
                            <option value="0">-- ALL --</option>
                        </select>
                    </div>
                </div>

                <!-- Ply -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label for="plysSelectBx" class="form-label"><span class="text-warning">Filter by</span> ply</label>
                        <select class="form-select"
                                id="plysSelectBx"
                                asp-items="@Model.PlysDropDown"
                                tabindex="6">
                            <option value="0">-- ALL --</option>
                        </select>
                    </div>
                </div>

                <!-- Combination Code -->
                <div class="col-sm-6">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.CorruCombId" class="form-label">Corru-comb code &ast;</label>
                        <select class="form-select select2"
                                asp-for="CorruCosting.CorruCombId"
                                asp-items="@Model.CorruCombinationDropDown"
                                tabindex="7">
                            <option value="0" selected>-- select --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.CorruCombId"></span></b>
                    </div>
                </div>

                <!-- Corru combination desc -->
                <div class="col-12 d-none">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label for="corruCombInputF" class="form-label">Corru combination</label>
                        <input type="text" class="form-control" id="corruCombInputF" placeholder="Corru combination" disabled>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Box Type Details Section</u></h2>
                </div>

                <!-- Box type -->
                <div class="col-6">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.BoxTypeId" class="form-label">Box type code &ast;</label>
                        <select class="select2-adv-search form-select"
                                asp-for="CorruCosting.BoxTypeId"
                                asp-items="@Model.BoxTypeDropDown"
                                tabindex="8">
                            <option value="0" selected>-- select --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.BoxTypeId"></span></b>
                    </div>
                </div>

                <!-- Design Box? -->
                <div class="col-6">
                    <div class="form-check mt-4 mb-3">
                        <input type="checkbox" class="form-check-input" id="designBoxCheckB" style="width: 1.5em; height: 1.5em;" disabled>
                        <label class="form-check-label" for="designBoxCheckB" style="font-size: 1.5em;">
                            &nbsp;&nbsp;Design Box?
                        </label>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Order Specification Section</u></h2>
                </div>

                <!-- UOM for QTY -->
                <div class="col-6 col-sm-3 d-none">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.OrderUomId" class="form-label">UOM <span class="text-warning">(for Qty)</span> &ast;</label>
                        <select class="form-select"
                                id="uomQtyOrKgSelectB"
                                asp-items="@Model.OrderUomDropDown" disabled>
                            <option value="0" selected>-- Unit --</option>
                        </select>
                        <input type="hidden" asp-for="CorruCosting.OrderUomId" />
                        <b><span class="text-danger" asp-validation-for="CorruCosting.OrderUomId"></span></b>
                    </div>
                </div>

                <!-- Order Qty -->
                <div class="col-6 col-sm-3">
                    <div class="mb-6">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.OrderQty" class="form-label">Order Qty &ast;</label>
                        <input type="text" class="form-control" asp-for="CorruCosting.OrderQty" placeholder="Qty in the selected UOM" tabindex="9">
                        <b><span class="text-danger" asp-validation-for="CorruCosting.OrderQty"></span></b>
                    </div>
                </div>

                <!-- Special Instructions -->
                <div class="col-12 col-sm-8">
                    <div class="form-group mb-3 text-white">
                        <label asp-for="CorruCosting.SpecialInstructions" class="form-label">Special instructions</label>
                        <textarea class="form-control" asp-for="CorruCosting.SpecialInstructions" rows="1"
                                  placeholder="If any, special instructions can be put here." tabindex="10"></textarea>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.SpecialInstructions"></span></b>
                    </div>
                </div>

            </div>
        </div><!-- End of Procuct Specification Section -->

        <!-- Product Messurement Section -->
        <div class="col-12">
            <div class="row">

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Product Measurement Section</u></h2>
                </div>

                <div class="col-12">
                    <!-- Row: product measurement -->
                    <div class="row">

                        <!-- Selected UOM -->
                        <div class="col-6 col-md-3">
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="CorruCosting.MeasurementUomId" class="form-label text-warning fw-bold">Select UOM</label>
                                <select class="form-select fw-bold"
                                        asp-for="CorruCosting.MeasurementUomId"
                                        asp-items="@Model.MeasurementUomDropDown"
                                        tabindex="11"
                                        readonly>
                                    <option value="0" selected>-- UOM --</option>
                                </select>
                                <b><span class="text-danger" asp-validation-for="CorruCosting.MeasurementUomId"></span></b>
                            </div>
                        </div>

                        <!-- System UOM -->
                        <div class="col-6 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label class="form-label text-warning fw-bold">System UOM</label>
                                <input type="text" class="form-control text-warning fw-bold" value="cm" disabled>
                            </div>
                        </div>

                        <!-- Selected UOM -->
                        <div class="col-6 col-md-3 d-none">
                            <!-- d-none d-md-block -->
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label for="selected_uom" class="form-label text-warning fw-bold">Selected UOM</label>
                                <input type="text" class="form-control text-warning fw-bold" id="selected_uom" disabled>
                            </div>
                        </div>

                        <!-- System UOM -->
                        <div class="col-6 col-md-3 d-none">
                            <!-- d-none d-md-block -->
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label class="form-label text-warning fw-bold">System UOM</label>
                                <input type="text" class="form-control text-warning fw-bold" value="cm" disabled>
                            </div>
                        </div>

                        <!-- Length -->
                        <div class="col-6 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="CorruCosting.Length" class="form-label">Length &ast;</label>
                                <input type="text" class="form-control" asp-for="CorruCosting.Length" placeholder="Length in selected UOM" tabindex="12">
                                <b><span class="text-danger" asp-validation-for="CorruCosting.Length"></span></b>
                            </div>
                        </div>

                        <!-- Length -->
                        <div class="col-6 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="lengthCmInputF" class="form-label">Length (cm)</label>
                                <input type="text" class="form-control" id="lengthCmInputF" placeholder="Length" disabled>
                            </div>
                        </div>

                        <!-- Bredth -->
                        <div class="col-6 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="CorruCosting.Bredth" class="form-label">Width (UOM) &ast;</label>
                                <input type="text" class="form-control" asp-for="CorruCosting.Bredth" placeholder="Bredth in selected UOM" tabindex="13">
                                <b><span class="text-danger" asp-validation-for="CorruCosting.Bredth"></span></b>
                            </div>
                        </div>

                        <!-- Bredth -->
                        <div class="col-6 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="bredthCmInputF" class="form-label">Bredth (cm)</label>
                                <input type="text" class="form-control" id="bredthCmInputF" placeholder="Bredth in cm" disabled>
                            </div>
                        </div>

                        <!-- Height -->
                        <div class="col-6 col-md-3">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="CorruCosting.Height" class="form-label">Height (UOM)</label>
                                <input type="text" class="form-control" asp-for="CorruCosting.Height" placeholder="Heigth in selected UOM" tabindex="14">
                                <b><span class="text-danger" asp-validation-for="CorruCosting.Height"></span></b>
                            </div>
                        </div>

                        <!-- Height -->
                        <div class="col-6 col-md-3 d-none">
                            <div class="mb-3">
                                <!-- To add some margin between form-controls -->
                                <label for="heightCmInputF" class="form-label">Height (cm)</label>
                                <input type="text" class="form-control" id="heightCmInputF" placeholder="Height in cm" disabled>
                            </div>
                        </div>

                        <!-- External / Internal -->
                        <div class="col-6 col-md-3">
                            <div class="mb-3 text-white">
                                <!-- To add some margin between form-controls -->
                                <label asp-for="CorruCosting.AreExternalMeasurements" class="form-label text-warning fw-bold">INT / EXT</label>
                                <select class="form-select fw-bold"
                                        asp-for="CorruCosting.AreExternalMeasurements"
                                        tabindex="15">
                                    <option value="1" selected>External Measurements</option>
                                    <option value="0">Internal Measurements</option>
                                </select>
                                <b><span class="text-danger" asp-validation-for="CorruCosting.AreExternalMeasurements"></span></b>
                            </div>
                        </div>

                    </div><!-- End of Row: product measurement -->
                </div>

                <div class="col-12">
                    <hr class="bg-primary border-2 border-primary" />
                </div>

                <div class="col-md-12 mt-3">
                    <h2 class="h5"><u>Printing Detail Section</u></h2>
                </div>

                <!-- Printed? checkbox -->
                <div class="col-sm-3">
                    <div class="form-check mt-4 mb-3">
                        <input class="form-check-input" asp-for="CorruCosting.Printed" style="width: 1.5em; height: 1.5em;" tabindex="16">
                        <label class="form-check-label" asp-for="CorruCosting.Printed" style="font-size: 1.5em;">
                            &nbsp;&nbsp;Printed?
                        </label>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.Printed"></span></b>
                    </div>
                </div>

                <!-- Laminated? checkbox -->
                <div class="col-sm-3">
                    <div class="form-check mt-4 mb-3">
                        <input class="form-check-input" asp-for="CorruCosting.Laminated" style="width: 1.5em; height: 1.5em;" tabindex="17">
                        <label class="form-check-label" asp-for="CorruCosting.Laminated" style="font-size: 1.5em;">
                            &nbsp;&nbsp;Laminated?
                        </label>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.Laminated"></span></b>
                    </div>
                </div>

                <!-- Die cut? checkbox -->
                <div class="col-sm-3">
                    <div class="form-check mt-4 mb-3">
                        <input class="form-check-input" asp-for="CorruCosting.DieCut" style="width: 1.5em; height: 1.5em;" tabindex="18">
                        <label class="form-check-label" asp-for="CorruCosting.DieCut" style="font-size: 1.5em;">
                            &nbsp;&nbsp;Die&nbsp;Cut?
                        </label>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.DieCut"></span></b>
                    </div>
                </div>

                <div class="col-sm-3"></div>

                <!-- No of colors -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.NoOfColors" class="form-label">No of colors</label>
                        <input type="text" class="form-control" asp-for="CorruCosting.NoOfColors" placeholder="No of colors" tabindex="19">
                        <b><span class="text-danger" asp-validation-for="CorruCosting.NoOfColors"></span></b>
                        <b><span class="text-danger" id="noOfColsErrorSpan">No of colors can't be 0 when "Printed?" is checked.</span></b>
                    </div>
                </div>

                <!-- Printing side -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.NoOfPrintingSides" class="form-label">Printing sides count</label>
                        <input type="text" class="form-control" asp-for="CorruCosting.NoOfPrintingSides" placeholder="Printing side" tabindex="20">
                        <b><span class="text-danger" asp-validation-for="CorruCosting.NoOfPrintingSides"></span></b>
                        <b><span class="text-danger" id="printSidesCountErrorSpan">Printing sides count can't be 0 when "Printed?" is checked.</span></b>
                    </div>
                </div>

                <!-- Print Type -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.PrintTypeId" class="form-label">Print type</label>
                        <select class="select2 form-select"
                                asp-for="CorruCosting.PrintTypeId"
                                asp-items="@Model.PrintTypeDropDown"
                                tabindex="21">
                            <option value="" selected>-- select print type --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.PrintTypeId"></span></b>
                        <b><span class="text-danger" id="printTypeErrorSpan">A Print type must be selected when "Printed?" is checked.</span></b>
                    </div>
                </div>

                <!-- Print Area % -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3">
                        <!-- To add some margin between form-controls -->
                        <label for="printAreaPercentInputF" class="form-label">Print Area %</label>
                        <input type="text" class="form-control" id="printAreaPercentInputF" placeholder="Print Area %" disabled>
                    </div>
                </div>

                <!-- Block -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.BlockAvailability" class="form-label">Block</label>
                        <select class="form-select"
                                asp-for="CorruCosting.BlockAvailability"
                                tabindex="22">
                            <option value="0" selected>-- select Block --</option>
                            <option value="1">New</option>
                            <option value="2">Available</option>
                            <option value="3">Balance Cut</option>
                            <option value="4">Digital Printed</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.BlockAvailability"></span></b>
                        <b><span class="text-danger" id="blockErrorSpan">A block must be selected when "Printed?" is checked.</span></b>
                    </div>
                </div>

                <!-- Laminate Type -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.LaminateTypeId" class="form-label">Laminate type</label>
                        <select class="form-select"
                                asp-for="CorruCosting.LaminateTypeId"
                                asp-items="@Model.LaminateTypeDropDown"
                                tabindex="23">
                            <option value="" selected>-- laminate type --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.LaminateTypeId"></span></b>
                        <b><span class="text-danger" id="laminateTypeErrorSpan">A laminate type must be selected when "Laminated?" is checked.</span></b>
                    </div>
                </div>

                <!-- Die cut type -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.DieCutTypeId" class="form-label">Die cut type</label>
                        <select class="form-select"
                                asp-for="CorruCosting.DieCutTypeId"
                                asp-items="@Model.DieCutTypeDropDown"
                                tabindex="24">
                            <option value="" selected>-- die cut type --</option>
                        </select>
                        <b><span class="text-danger" asp-validation-for="CorruCosting.DieCutTypeId"></span></b>
                        <b><span class="text-danger" id="dieCutTypeErrorSpan">A die cut type must be selected when "Die Cut?" is checked.</span></b>
                    </div>
                </div>

                <!-- Finishing type -->
                <div class="col-6 col-sm-3">
                    <div class="mb-3 text-white">
                        <!-- To add some margin between form-controls -->
                        <label asp-for="CorruCosting.CorruProductFinishingTypeId" class="form-label">Product finishing type</label>
                        <select class="form-select"
                                asp-for="CorruCosting.CorruProductFinishingTypeId"
                                asp-items="@Model.FinishingTypeDropDown"
                                tabindex="25">
