            var upsInputF = $('#CorruCosting_Ups'); // 9: Ups On Set
            var preCWastePercentInputF = $('#CorruCosting_PreCostingWastePercentage'); // 10: Pre-Costing Waste On Change
            var fixedExcessInputF = $('#fixedExcessInputF'); // 11: Route On Change
