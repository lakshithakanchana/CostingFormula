@section Scripts{

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">

        // Global Variables
        const customersJsonArr = @Html.Raw(ViewBag.customersJsonStr);
        const boxTypeJsonArr = @Html.Raw(ViewBag.boxTypeJsonStr);
        const corruCombinationJsonArr = @Html.Raw(ViewBag.corruCombinationJsonStr);
        const uomJsonArr = @Html.Raw(ViewBag.uomJsonStr);
        const printTypeJsonArr = @Html.Raw(ViewBag.printTypeJsonStr);
        const routeJsonArr = @Html.Raw(ViewBag.routeJsonStr);
        const itemCategoryJsonArr = @Html.Raw(ViewBag.itemCategoryJsonStr);
        const placementJsonArr = @Html.Raw(ViewBag.placementJsonStr);
        const reelSizeJsonArr = @Html.Raw(ViewBag.reelSizeJsonStr);
        const MAX_SHEET_LENGTH_CM = 250;

        // Common Functions...........................................................................
        function getObjectByIdProp(json_array, Id) {
            for (i = 0; i < json_array.length; i++) {
                if (json_array[i].Id == Id)
                    return json_array[i];
            }
            return null;
        }

        function getObjectsByColorIdAndPlyIdProps(json_array, colorId, plys) {
            var sub_json_array = [];
            if (plys === "0") {
                for (i = 0; i < json_array.length; i++) {
                    if (json_array[i].ColorId == colorId)
                        sub_json_array.push(json_array[i]);
                }
                return sub_json_array;
            } else if (colorId === "0") {
                for (i = 0; i < json_array.length; i++) {
                    if (json_array[i].NoOfPlys == plys)
                        sub_json_array.push(json_array[i]);
                }
                return sub_json_array;
            }
            for (i = 0; i < json_array.length; i++) {
                if (json_array[i].ColorId == colorId && json_array[i].NoOfPlys == plys)
                    sub_json_array.push(json_array[i]);
            }
            return sub_json_array;
        }

        function getSheetLengthAfterSettingNoOfBoards() {

            var boxTypeInputF = $('#CorruCosting_BoxTypeId'); // 1
            var isExternal = $('#CorruCosting_AreExternalMeasurements').val() === '1'
                || $('#CorruCosting_AreExternalMeasurements').val() === 'true' ? true : false; // 2
            var lengthCmInputF = $('#lengthCmInputF'); // 3
            var bredthCmInputF = $('#bredthCmInputF'); // 4
            var heightCmInputF = $('#heightCmInputF'); // 5
            var noOfBoardsInputF = $('#CorruCosting_NoOfBoards'); // 6
            var submitButton = $('#submitButton');
            var submitButtonMaxLengthOverflowErrorSpan = $('#submitButtonMaxLengthOverflowErrorSpan');

            var isSheetLengthFormulaNull = false;
            var isSheetLengthFormulaIfSLExceeds = false;

            if (boxTypeInputF.val() !== "0") {

                var boxTypeObj = getObjectByIdProp(boxTypeJsonArr, boxTypeInputF.val());
                var sheetLengthFormula, sheetLengthFormulaIfSLExceeds;

                if (isExternal) {
                    sheetLengthFormula = boxTypeObj.ESheetLengthFormula;
                    sheetLengthFormulaIfSLExceeds = boxTypeObj.ESheetLengthFormulaIfSLExceeds;
                }
                else {
                    sheetLengthFormula = boxTypeObj.ISheetLengthFormula;
                    sheetLengthFormulaIfSLExceeds = boxTypeObj.ISheetLengthFormulaIfSLExceeds;
                }

                if (sheetLengthFormula === null || sheetLengthFormula === undefined || sheetLengthFormula.trim() === '') {
                    sheetLengthFormula = '';
                    isSheetLengthFormulaNull = true;
                }
                if (sheetLengthFormulaIfSLExceeds === null || sheetLengthFormulaIfSLExceeds === undefined || sheetLengthFormulaIfSLExceeds.trim() === '') {
                    sheetLengthFormulaIfSLExceeds = '';
                    isSheetLengthFormulaIfSLExceeds = true;
                }

                if (sheetLengthFormula.includes("Le")) {
                    if (lengthCmInputF.val() === "") {
                        sheetLengthFormula = "";
                    } else {
                        sheetLengthFormula = sheetLengthFormula.replace("Le", lengthCmInputF.val());
                    }
                }
                if (sheetLengthFormulaIfSLExceeds.includes("Le")) {
                    if (lengthCmInputF.val() === "") {
                        sheetLengthFormulaIfSLExceeds = "";
                    } else {
                        sheetLengthFormulaIfSLExceeds = sheetLengthFormulaIfSLExceeds.replace("Le", lengthCmInputF.val());
                    }
                }
                if (sheetLengthFormula.includes("Br")) {
                    if (bredthCmInputF.val() === "") {
                        sheetLengthFormula = "";
                    } else {
                        sheetLengthFormula = sheetLengthFormula.replace("Br", bredthCmInputF.val());
                    }
                }
                if (sheetLengthFormulaIfSLExceeds.includes("Br")) {
                    if (bredthCmInputF.val() === "") {
                        sheetLengthFormulaIfSLExceeds = "";
                    } else {
                        sheetLengthFormulaIfSLExceeds = sheetLengthFormulaIfSLExceeds.replace("Br", bredthCmInputF.val());
                    }
                }
                if (sheetLengthFormula.includes("He")) {
                    if (heightCmInputF.val() === "") {
                        sheetLengthFormula = "";
                    } else {
                        sheetLengthFormula = sheetLengthFormula.replace("He", heightCmInputF.val());
                    }
                }
                if (sheetLengthFormulaIfSLExceeds.includes("He")) {
                    if (heightCmInputF.val() === "") {
                        sheetLengthFormulaIfSLExceeds = "";
                    } else {
                        sheetLengthFormulaIfSLExceeds = sheetLengthFormulaIfSLExceeds.replace("He", heightCmInputF.val());
                    }
                }

                if (sheetLengthFormula === "") {

                    noOfBoardsInputF.val('');
                    setTotalBoardsReq_onChange();
                    updateRawMaterialGrid_onChange();

                    if (isSheetLengthFormulaNull) {
                        if (sheetLengthFormula === undefined || sheetLengthFormula === null || sheetLengthFormula === '') {
                            iziToast.warning({
                                title: 'Warinig',
                                message: 'Sheet length is empty in the box type master. Try changin Int/Ext or the Box Type!',
                                position: 'topRight',
                                timeout: 15000
                            });
                        }
                    }

                    return "";

                } else {
                    var sheetLength;
                    try {
                        sheetLength = eval(sheetLengthFormula);
                    } catch (e) {
                        sheetLength = NaN;
                        iziToast.error({
                            title: 'Error',
                            message: 'Box Type measurement error!! ' + e.message,
                            position: 'topRight',
                            timeout: 15000
                        });
                    }

                    if (sheetLength <= MAX_SHEET_LENGTH_CM) {

                        noOfBoardsInputF.val('1');
                        setTotalBoardsReq_onChange();
                        updateRawMaterialGrid_onChange();

                        return sheetLength;

                    }
                    else {

                        if (isSheetLengthFormulaIfSLExceeds) {
                            if (sheetLengthFormulaIfSLExceeds === undefined || sheetLengthFormulaIfSLExceeds === null || sheetLengthFormulaIfSLExceeds === '') {
                                iziToast.warning({
                                    title: 'Warinig',
                                    message: 'Sheet length(> Max Sheet Length) is empty in the box type master. Try changin Int/Ext or the Box Type!',
                                    position: 'topRight',
                                    timeout: 15000
                                });
                            }
                        }

                        noOfBoardsInputF.val('2');
                        setTotalBoardsReq_onChange();
                        updateRawMaterialGrid_onChange();

                        var sheetLengthIfSLExceeds;
                        try {
                            sheetLengthIfSLExceeds = eval(sheetLengthFormulaIfSLExceeds);
                        } catch (e) {
                            sheetLengthIfSLExceeds = NaN;
                            iziToast.error({
                                title: 'Error',
                                message: 'Box Type measurement error!! ' + e.message,
                                position: 'topRight',
                                timeout: 15000
                            });
                        }
                        if (sheetLengthIfSLExceeds > MAX_SHEET_LENGTH_CM) {
                            // Disable submit button
                            submitButton.prop('disabled', true);
                            // Show submit button error message
                            submitButtonMaxLengthOverflowErrorSpan.show();
                            // Give a notification
                            iziToast.warning({
                                title: 'Warinig',
                                message: 'Sheet length exceeds the standared sheet size!',
                                position: 'topRight',
                                timeout: 15000
                            });

                            return sheetLengthIfSLExceeds;
                        } else {
                            // Enable submit button
                            submitButton.prop('disabled', false);
                            // Show submit button error message
                            submitButtonMaxLengthOverflowErrorSpan.hide();

                            return sheetLengthIfSLExceeds;
                        }

                    }
                }

            } else {

                noOfBoardsInputF.val('');
                setTotalBoardsReq_onChange();
                updateRawMaterialGrid_onChange();

                return "";

            }
        }

        function getSheetWidth() {
            var boxTypeInputF = $('#CorruCosting_BoxTypeId');
            var isExternal = $('#CorruCosting_AreExternalMeasurements').val() === '1'
                || $('#CorruCosting_AreExternalMeasurements').val() === 'true' ? true : false;
            var lengthCmInputF = $('#lengthCmInputF');
            var bredthCmInputF = $('#bredthCmInputF');
            var heightCmInputF = $('#heightCmInputF');

            if (boxTypeInputF.val() !== "0") {

                var boxTypeObj = getObjectByIdProp(boxTypeJsonArr, boxTypeInputF.val());
                var sheetWidthFormula;

                if (isExternal) {
                    sheetWidthFormula = boxTypeObj.ESheetWidthFormula;
                }
                else {
                    sheetWidthFormula = boxTypeObj.ISheetWidthFormula;
                }

                if (sheetWidthFormula === null || sheetWidthFormula === undefined || sheetWidthFormula.trim() === '') {
                    sheetWidthFormula = '';
                    iziToast.warning({
                        title: 'Warinig',
                        message: 'Sheet width is empty in the box type master. Try changin Int/Ext or the Box Type!',
                        position: 'topRight',
                        timeout: 15000
                    });
                }

                if (sheetWidthFormula.includes("Le")) {
                    if (lengthCmInputF.val() === "") {
                        sheetWidthFormula = "";
                    } else {
                        sheetWidthFormula = sheetWidthFormula.replace("Le", lengthCmInputF.val());
                    }
                }
                if (sheetWidthFormula.includes("Br")) {
                    if (bredthCmInputF.val() === "") {
                        sheetWidthFormula = "";
                    } else {
                        sheetWidthFormula = sheetWidthFormula.replace("Br", bredthCmInputF.val());
                    }
                }
                if (sheetWidthFormula.includes("He")) {
                    if (heightCmInputF.val() === "") {
                        sheetWidthFormula = "";
                    } else {
                        sheetWidthFormula = sheetWidthFormula.replace("He", heightCmInputF.val());
                    }
                }

                if (sheetWidthFormula === "") {
                    return "";
                } else {
                    var sheetWidth;
                    try {
                        sheetWidth = eval(sheetWidthFormula);
                    } catch (e) {
                        sheetWidth = NaN;
                        iziToast.error({
                            title: 'Error',
                            message: 'Box Type measurement error!! ' + e.message,
                            position: 'topRight',
                            timeout: 15000
                        });
                    }
                    return sheetWidth;
                }

            } else {
                return "";
            }
        }

        function makePrintingLaminatingDieCutSpecificationsRequiredConditionally_onChange() {

            var submitButton = $('#submitButton');
            var printedCheckBox = $('#CorruCosting_Printed');
            var laminatedCheckBox = $('#CorruCosting_Laminated');
            var dieCutCheckBox = $('#CorruCosting_DieCut');
            var noOfColsInputF = $('#CorruCosting_NoOfColors');
            var printSidesCountInputF = $('#CorruCosting_NoOfPrintingSides');
            var printTypeSelectB = $('#CorruCosting_PrintTypeId');
            var blockSelectB = $('#CorruCosting_BlockAvailability');
            var laminateTypeSelectB = $('#CorruCosting_LaminateTypeId');
            var dieCutTypeSelectB = $('#CorruCosting_DieCutTypeId');
            var laminateCostTotalInputF = $('#CorruCosting_LaminateCostTotal');
            var dieCostTotalInputF = $('#CorruCosting_DieCostTotal');

            var noOfColsErrorSpan = $('#noOfColsErrorSpan');
            var printSidesCountErrorSpan = $('#printSidesCountErrorSpan');
            var printTypeErrorSpan = $('#printTypeErrorSpan');
            var blockErrorSpan = $('#blockErrorSpan');
            var laminateTypeErrorSpan = $('#laminateTypeErrorSpan');
            var dieCutTypeErrorSpan = $('#dieCutTypeErrorSpan');
            var laminateCostTotalRequiredErrorSpan = $('#laminateCostTotalRequiredErrorSpan');
            var dieCostTotalRequiredErrorSpan = $('#dieCostTotalRequiredErrorSpan');

            var submitButtonRequiredFieldErrorSpan = $('#submitButtonRequiredFieldErrorSpan');

            var isPrinted = printedCheckBox.is(":checked");
            var isLaminated = laminatedCheckBox.is(":checked");
            var isDieCut = dieCutCheckBox.is(":checked");

            var printedError = false;
            var laminateTypeError = false;
            var dieCutTypeError = false;
            var laminateTotalCostError = false;
            var dieTotalCostError = false;

            if (isPrinted) {
                var noOfColsError = noOfColsInputF.val().trim() === '' || Number(noOfColsInputF.val()) < 1;
                var printSidesCountError = printSidesCountInputF.val().trim() === '' || Number(printSidesCountInputF.val()) < 1;
                var printTypeError = printTypeSelectB.val().trim() === '' || printTypeSelectB.val() === '0';
                var blockError = blockSelectB.val().trim() === '' || blockSelectB.val() === '0';

                if (noOfColsError) {
                    noOfColsErrorSpan.show();
                    printedError = true;
                }
                else
                    noOfColsErrorSpan.hide();

                if (printSidesCountError) {
                    printSidesCountErrorSpan.show();
                    printedError = true;
                }
                else
                    printSidesCountErrorSpan.hide();

                if (printTypeError) {
                    printTypeErrorSpan.show();
                    printedError = true;
                }
                else
                    printTypeErrorSpan.hide();

                if (blockError) {
                    blockErrorSpan.show();
                    printedError = true;
                }
                else
                    blockErrorSpan.hide();
            } else {
                noOfColsErrorSpan.hide();
                printSidesCountErrorSpan.hide();
                printTypeErrorSpan.hide();
                blockErrorSpan.hide();
            }

            if (isLaminated) {
                if (laminateTypeSelectB.val().trim() === '' || laminateTypeSelectB.val() === '0') {
                    laminateTypeErrorSpan.show();
                    laminateTypeError = true;
                }
                else
                    laminateTypeErrorSpan.hide();
                if (laminateCostTotalInputF.val() === '' || Number(laminateCostTotalInputF.val()) === 0) {
                    laminateCostTotalRequiredErrorSpan.show();
                    laminateTotalCostError = true;
                } else
                    laminateCostTotalRequiredErrorSpan.hide();
            } else {
                laminateTypeErrorSpan.hide();
                laminateCostTotalRequiredErrorSpan.hide();
            }

            if (isDieCut) {
                if (dieCutTypeSelectB.val().trim() === '' || dieCutTypeSelectB.val() === '0') {
                    dieCutTypeErrorSpan.show();
                    dieCutTypeError = true;
                }
                else
                    dieCutTypeErrorSpan.hide();
                if (dieCostTotalInputF.val() === '' || Number(dieCostTotalInputF.val()) === 0) {
                    dieCostTotalRequiredErrorSpan.show();
                    dieTotalCostError = true;
                } else
                    dieCostTotalRequiredErrorSpan.hide();
            } else {
                dieCutTypeErrorSpan.hide();
                dieCostTotalRequiredErrorSpan.hide();
            }

            if (printedError || laminateTypeError || dieCutTypeError || laminateTotalCostError || dieTotalCostError) {
                submitButton.prop('disabled', true);
                submitButtonRequiredFieldErrorSpan.show();
            }
            else {
                submitButton.prop('disabled', false);
                submitButtonRequiredFieldErrorSpan.hide();
            }
        
        }

        function setSheetLengthWidthAndAreaInputFs_onChange() {
            
            var sheetLengthInputF = $('#CorruCosting_SheetLength');
            var sheetWidthInputF  = $('#CorruCosting_SheetWidth');
            var areaInputF        = $('#CorruCosting_Area');
            var adjSheetLengthInputF = $('#CorruCosting_AdjSheetLength');
            var adjSheetWidthInputF = $('#CorruCosting_AdjSheetWidth');
            var adjAreaInputF = $('#CorruCosting_AreaAfterAdj');
            var sheetLength = getSheetLengthAfterSettingNoOfBoards();
            var sheetWidth = getSheetWidth();

            if(sheetLength === undefined || sheetLength === '') {
                sheetLengthInputF.val('');
                adjSheetLengthInputF.val('');
            }
            else {
                sheetLengthInputF.val(sheetLength.toFixed(4));
                adjSheetLengthInputF.val(sheetLength.toFixed(4));
            }

            if(sheetWidth === undefined || sheetWidth === '') {
                sheetWidthInputF.val('');
                adjSheetWidthInputF.val('');
            }
            else {
                sheetWidthInputF.val(sheetWidth.toFixed(4));
                adjSheetWidthInputF.val(sheetWidth.toFixed(4));
            }

            if (sheetLength === '' || sheetWidth === '' || sheetLength === undefined || sheetWidth === undefined) {
                areaInputF.val('');
                adjAreaInputF.val('');
            }
            else {
                var area = Number(sheetLength) * Number(sheetWidth);
                areaInputF.val(area.toFixed(4));
                adjAreaInputF.val(area.toFixed(4));
            }

            setPrintedArea_onChange();
            setBestReelAndUps_onChange();
            setTotalSheetLength_onChange();
            updateRawMaterialGrid_onChange();
                
        }

        function setPrintedArea_onChange() {

            var printAreaInputF = $('#printAreaInputF');
            var printAreaPercentInputF = $('#printAreaPercentInputF');
            var areaInputF = $('#CorruCosting_Area');

            if (printAreaPercentInputF.val() === '' || areaInputF.val() === '')
                printAreaInputF.val('');
            else
                printAreaInputF.val(
                    ( Number(printAreaPercentInputF.val()) * Number(areaInputF.val()) / 100 ).toFixed(4)
                );

        }

        function setBestReelAndUps_onChange() {

            //reelSizeJsonArr
            var bestReelInputF = $('#CorruCosting_BestReelSize');
            var upsInputF = $('#CorruCosting_Ups');
            var adjSheetWidthInputF = $('#CorruCosting_AdjSheetWidth');
            var trimInputF = $('#CorruCosting_Trim');

            var bestReel = '';
            var noOfUps = '';
            var minWastePerUp = undefined;

            if(adjSheetWidthInputF.val() !== '' && trimInputF.val() !== '') {
                for(var u = 3; u >= 1; u--) {

                    reelSizeJsonArr.forEach((reelSizeJM) => {
                        var requiredWidth = (Number(adjSheetWidthInputF.val()) * u) + Number(trimInputF.val());
                        if (requiredWidth !== NaN) {
                            if (minWastePerUp === undefined) {
                                if (reelSizeJM.Size >= requiredWidth) {
                                    minWastePerUp = (reelSizeJM.Size - requiredWidth) / u;
                                    bestReel = reelSizeJM.Size;
                                    noOfUps = u;
                                }
                            } else {
                                if (reelSizeJM.Size >= requiredWidth) {
                                    var wastePerUp = (reelSizeJM.Size - requiredWidth) / u;
                                    if (minWastePerUp > wastePerUp) {
                                        minWastePerUp = wastePerUp;
                                        bestReel = reelSizeJM.Size;
                                        noOfUps = u;
                                    }
                                }
                            }
                        }
                    });

                }
            }

            if(minWastePerUp === undefined) {
                bestReelInputF.val('');
                upsInputF.val('');
            } else {
                bestReelInputF.val(
                    bestReel
                );
                upsInputF.val(
                    noOfUps
                );
            }

            setTotalBoardsReq_onChange();
            updateRawMaterialGrid_onChange();
            // setTotalSheetReq_onChange();

        }

        function setTotalSheetReq_onChange() {

            var totalSheetReqInputF = $('#CorruCosting_TotalSheetReq');
            var orderQtyInputF = $('#CorruCosting_OrderQty'); // 1: On Ord Qty Change
            var fixedExcessInputF = $('#fixedExcessInputF'); // 2: Route change
            var handlingWastePercentInputF = $('#handlingWastePercentInputF'); // 2: Route change
            var noOfBoardsInputF = $('#CorruCosting_NoOfBoards'); //3: OnSetNoOfBoards
            var upsInputF = $('#CorruCosting_Ups'); // 4: On set ups

            var orderQty = Number(orderQtyInputF.val());
            var ups = Number(upsInputF.val());

            var totalSheetReq = (
                orderQty + Number(fixedExcessInputF.val()) + (orderQty * Number(handlingWastePercentInputF.val()) / 100)
            ) * Number(noOfBoardsInputF.val());

            if (totalSheetReq !== NaN) {

                // Round to celling
                totalSheetReq = Math.ceil(totalSheetReq);

                if(ups === 0)
                    totalSheetReq = '';
                else if (ups !== NaN) {
                    // Make divicable by ups
                    while (totalSheetReq % ups !== 0) {
                        totalSheetReq++;
                    }
                }

            }

            totalSheetReqInputF.val(totalSheetReq);

            setTotalSheetLength_onChange();
            setTotalBoardsReq_onChange();

        }

        function setTotalSheetLength_onChange() {

            var totalSheetLengthInputF = $('#CorruCosting_TotalSheetlength');
            var adjSheetLengthInputF = $('#CorruCosting_AdjSheetLength'); // 1: AdjSheetLength On Set
            var totalSheetReqInputF = $('#CorruCosting_TotalSheetReq'); // 2: TotalSheetReq On Set

            totalSheetLengthInputF.val(
                ( Number(adjSheetLengthInputF.val()) * Number(totalSheetReqInputF.val()) ).toFixed(4)
            );

        }

        function setTotalBoardsReq_onChange() {

            var totalBoardsReqInputF = $('#CorruCosting_TotalBoardReq');
