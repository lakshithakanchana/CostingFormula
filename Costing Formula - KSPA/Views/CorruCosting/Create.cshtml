        // On document ready..........................................................................
        $(document).ready(function () {

            const TRIM_VAL = $('#CorruCosting_Trim').val();
            const ADJ_SHEET_LENGTH_VAL = $('#CorruCosting_AdjSheetLength').val();
            const ADJ_SHEET_WIDTH_VAL = $('#CorruCosting_AdjSheetWidth').val();
            const ADJ_UNIT_PRICE_VAL = $('#CorruCosting_PerUnitAdjustableUnitPrice').val();

            $('select.select2').select2({
                theme: 'bootstrap-5'
            });

            $("select.select2-adv-search").select2({
                matcher: matchCustom,
                sorter: sortCustom,
                theme: 'bootstrap-5'
            });
            $('#CorruCosting_OrderUomId').val("1");
            $('#submitButtonMaxLengthOverflowErrorSpan').hide();
            $('#saveBtnErrorSpan').hide();

            function sortCustom(data) {
                return data.sort(function (a, b) {
                    // If both 'a' and 'b' contains "RSC Normal" return 0
                    // If 'a' contains "RSC Normal" return -1
                    // If 'b' contains "RSC Normal" return 1
                    // Else conpare normally
                    let priorityStr = "RSC NORMAL";
                    let alwaysAtTop = "-- ";
                    let aIsTop = a.text.indexOf(alwaysAtTop) >= 0;
                    let bIsTop = b.text.indexOf(alwaysAtTop) >= 0;
                    let aContainsRSCN = a.text.indexOf(priorityStr) >= 0;
                    let bContainsRSCN = b.text.indexOf(priorityStr) >= 0;
                    if (aIsTop && bIsTop) {
                        return a.text.localeCompare(b.text);
                    } else if (aIsTop) {
                        return -1;
                    } else if (bIsTop) {
                        return 1;
                    } else if (aContainsRSCN && bContainsRSCN) {
                        return a.text.localeCompare(b.text);
                    } else if (aContainsRSCN) {
                        return -1;
                    } else if (bContainsRSCN) {
                        return 1;
                    } else {
                        return a.text.localeCompare(b.text);
                    }
                });
            }

            function matchCustom(params, data) {
                // If there are no search terms, return all of the data
                if ($.trim(params.term) === '') {
                    return data;
                }

                var paramWordArray = params.term.split(" ");
                var atleastOneWordPercent = false;
                var allWordsPercent = true;

                for (var i = 0; i < paramWordArray.length; i++) {
                    if (paramWordArray[i] !== '') {
                        if (data.text.toUpperCase().indexOf(paramWordArray[i].toUpperCase()) > -1) {
                            atleastOneWordPercent = true;
                            allWordsPercent = allWordsPercent && true;
                        } else {
                            allWordsPercent = false;
                        }
                    }
                }

                if (atleastOneWordPercent && allWordsPercent) {
                    return data;
                }

                // Return `null` if the term should not be displayed
                return null;
            }

            // Customer Detail Section................................................................
            var cusTypeInputF = $('#cusTypeInputF');
            var cusCurrencyInputF = $('#cusCurrencyInputF');
            var nativeCurrencyLabels = $('.native-currency');
            var exRateInputF = $('#exRateInputF');
            var deliAddressTextA = $('#CorruCosting_DeliveryAddress');

            // Set UOM for Qty to Qty
            $('#uomQtyOrKgSelectB').val('1');

            $("#CorruCosting_CustomerId").change(function () {
                var customer = getObjectByIdProp(customersJsonArr, $(this).val());
                if (customer !== null) {
                    cusTypeInputF.val(customer.CustomerTypeDesc);
                    cusCurrencyInputF.val(customer.CurrencyCode);
                    nativeCurrencyLabels.html(customer.CurrencyCode);
                    exRateInputF.val(customer.RateInLKR);
                    deliAddressTextA.val(customer.CustomerAddress);
                } else {
                    cusTypeInputF.val('');
                    cusCurrencyInputF.val('');
                    nativeCurrencyLabels.html('Native Currency')
                    exRateInputF.val('');
                    deliAddressTextA.val('');
                }
                updateRawMaterialGrid_onChange(); // #UnComment
                updateAdjSalesPrice_onKeyup(); // #UnComment
