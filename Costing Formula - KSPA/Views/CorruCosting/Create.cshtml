            $('#salesPricePerUnit').val(salesPricePerUnit.toFixed(4));
            var salesPriceTotal = totalTotal * 125 / 100;
            $('#salesPriceTotal').val(salesPriceTotal.toFixed(4));
            var salesPricePerKg = totalPerKg * 125 / 100;
            $('#salesPricePerKg').val(salesPricePerKg.toFixed(4));

