        function updateSummaryGrid_onChange() {

            // Weight section.......................................................................................
            var weightTotalInputF = $('#weightTotalInputF');
            var weightPerUnitInputF = $('#weightPerUnitInputF');
            var orderQtyInputF = $('#CorruCosting_OrderQty'); // 1: OrdQty On Change
            var iCatWiseTotalWeightInputFs = $('.iCatWiseTotalWeightInputFs'); // 2: iCatWiseTotalWeightInputF(s) On Set
            
            var iCatWiseTotalWeight = 0;
            var iCatWiseUnitWeight = 0;
            var orderQty = Number(orderQtyInputF.val());

            if (iCatWiseTotalWeightInputFs.length !== 0) {
                for (var i = 0; i < iCatWiseTotalWeightInputFs.length; i++) {
                    if (!isNaN(parseFloat($(iCatWiseTotalWeightInputFs[i]).val())))
                        iCatWiseTotalWeight += Number($(iCatWiseTotalWeightInputFs[i]).val());
                }
            }
            if (iCatWiseTotalWeight === 0) {
                weightTotalInputF.val('');
                weightPerUnitInputF.val('');
            }
            else {
                weightTotalInputF.val(iCatWiseTotalWeight.toFixed(4));
                if(orderQty !== 0)
                    iCatWiseUnitWeight = iCatWiseTotalWeight / orderQty;
                weightPerUnitInputF.val(iCatWiseUnitWeight.toFixed(4));
            }

            // Material cost section.................................................................................
            var matCostTotalInputF = $('#matCostTotalInputF');
            var matCostPerUnitInputF = $('#matCostPerUnitInputF');
            var matCostPerKgInputF = $('#matCostPerKgInputF');
            var iCatWiseTotalCostInputFs = $('.iCatWiseTotalCostInputFs');// 3: iCatWiseTotalCostInputF(s) On Set

            var iCatWiseTotalCost = 0;
            var iCatWiseUnitCost = 0;
            var iCatWiseCostPerKg = 0

            if (iCatWiseTotalCostInputFs.length !== 0) {
                // set mat cost per unit
                for (var i = 0; i < iCatWiseTotalCostInputFs.length; i++) {
                    if (!isNaN(parseFloat($(iCatWiseTotalCostInputFs[i]).val())))
                        iCatWiseTotalCost += Number($(iCatWiseTotalCostInputFs[i]).val());
                }
            }
            if (iCatWiseTotalCost === 0) {
                matCostTotalInputF.val('');
                matCostPerUnitInputF.val('');
                matCostPerKgInputF.val('');
            } else {
                matCostTotalInputF.val(iCatWiseTotalCost.toFixed(4));
                if (orderQty !== 0)
                    iCatWiseUnitCost = iCatWiseTotalCost / orderQty;
                matCostPerUnitInputF.val(iCatWiseUnitCost.toFixed(4));
                if (iCatWiseTotalWeight !== 0)
                    iCatWiseCostPerKg = iCatWiseTotalCost / iCatWiseTotalWeight;
                matCostPerKgInputF.val(iCatWiseCostPerKg.toFixed(4));
            }

            // Overhead cost section.................................................................................
            var overHeadCostPerKgInputF = $('#overHeadCostPerKgInputF');
            var ohcPerKg = Number(overHeadCostPerKgInputF.val());
            var ohcTotal = ohcPerKg * iCatWiseTotalWeight;
            var ohcPerUnit = ohcTotal / orderQty;
            $('#overHeadCostTotalInputF').val(
                ohcTotal.toFixed(4)
            );
            $('#overHeadCostPerUnitInpurF').val(
                ohcPerUnit.toFixed(4)
            );

            // Block cost section....................................................................................
            var blockCostTotalInputF = $('#CorruCosting_BlockCostTotal');
            var blockCostTotal = Number(blockCostTotalInputF.val());
            var blockCostPerUnit = blockCostTotal / orderQty;
            var blockCostPerKg = blockCostTotal / iCatWiseTotalWeight;
            $('#blockCostPerUnitInpurF').val(
                blockCostPerUnit.toFixed(4)
            );
            $('#blockCostPerKgInputF').val(
                blockCostPerKg.toFixed(4)
            );

            // Laminate cost section....................................................................................
            var laminateCostTotalInputF = $('#CorruCosting_LaminateCostTotal');
            var laminateCostTotal = Number(laminateCostTotalInputF.val());
            var laminateCostPerUnit = laminateCostTotal / orderQty;
            var laminateCostPerKg = laminateCostTotal / iCatWiseTotalWeight;
            $('#laminateCostPerUnitInpurF').val(
                laminateCostPerUnit.toFixed(4)
            );
            $('#laminateCostPerKgInputF').val(
                laminateCostPerKg.toFixed(4)
            );

            // Die cost section....................................................................................
            var dieCostTotalInputF = $('#CorruCosting_DieCostTotal');
            var dieCostTotal = Number(dieCostTotalInputF.val());
            var dieCostPerUnit = dieCostTotal / orderQty;
            var dieCostPerKg = dieCostTotal / iCatWiseTotalWeight;
            $('#dieCostPerUnitInpurF').val(
                dieCostPerUnit.toFixed(4)
            );
            $('#dieCostPerKgInputF').val(
                dieCostPerKg.toFixed(4)
            );

            // Other cost section....................................................................................
            var otherCostTotalInputF = $('#CorruCosting_OtherCostTotal');
            var otherCostTotal = Number(otherCostTotalInputF.val());
            var otherCostPerUnit = otherCostTotal / orderQty;
            var otherCostPerKg = otherCostTotal / iCatWiseTotalWeight;
            $('#otherCostPerUnitInpurF').val(
                otherCostPerUnit.toFixed(4)
            );
            $('#otherCostsInputF').val(
                otherCostPerKg.toFixed(4)
            );

            // Total section.........................................................................................
            var totalPerUnit = iCatWiseUnitCost + ohcPerUnit + blockCostPerUnit + laminateCostPerUnit + dieCostPerUnit + otherCostPerUnit;
            $('#totalPerUnit').val(
                totalPerUnit.toFixed(4)
            );

            var totalTotal = iCatWiseTotalCost + ohcTotal + blockCostTotal + laminateCostTotal + dieCostTotal + otherCostTotal;
            $('#totalTotal').val(
                totalTotal.toFixed(4)
