            var salesPricePerKgInNativeC = salesPricePerKg / Number(exRateInputF.val());
            $('#nativeSalesPricePerKg').val(
                salesPricePerKgInNativeC.toFixed(4)
            );

            // Adjustable sales price (in native currency)
            $('#CorruCosting_PerUnitAdjustableUnitPrice').val(salesPricePerUnitInNativeC.toFixed(4));
            $('#adjSalesPriceTotal').val(salesPriceTotalInNativeC.toFixed(4));
            $('#adjSalesPricePerKg').val(salesPricePerKgInNativeC.toFixed(4));

            $('#adjProfitPercentPerUnit').val("25.00%");
            $('#adjProfitPercentTotal').val("25.00%");
            $('#adjProfitPercentPerKg').val("25.00%");

            updateAdjSalesPrice_onKeyup();
        }

        function updateAdjSalesPrice_onKeyup() {
            var totalWeight = 0;
            var iCatWiseTotalWeightInputFs = $('.iCatWiseTotalWeightInputFs'); // 1: updateSummaryGrid_onChange()
            var adjSalesPricePerUnit = $('#CorruCosting_PerUnitAdjustableUnitPrice'); // 1: updateSummaryGrid_onChange() + 2: adjSalesPricePerUnit On Change
            var orderQtyInputF = $('#CorruCosting_OrderQty'); // 3: orderQty On Change
            var totalPerUnit = $('#totalPerUnit'); // 1: updateSummaryGrid_onChange()
            var exRateInputF = $('#exRateInputF'); // 4: Customer On Change
            var adjSalesPricePerKgInputF = $('#adjSalesPricePerKg'); // 1: updateSummaryGrid_onChange()
            var adjSalesPriceTotalInputF = $('#adjSalesPriceTotal'); // 1: updateSummaryGrid_onChange()

            // Calculating the total weight
            if (iCatWiseTotalWeightInputFs.length !== 0) {
                for (var i = 0; i < iCatWiseTotalWeightInputFs.length; i++) {
                    if (!isNaN(parseFloat($(iCatWiseTotalWeightInputFs[i]).val())))
                        totalWeight += Number($(iCatWiseTotalWeightInputFs[i]).val());
                }
            }

            var adjSalesPriceTotal = Number(adjSalesPricePerUnit.val()) * Number(orderQtyInputF.val());
            adjSalesPriceTotalInputF.val(
                adjSalesPriceTotal.toFixed(4)
            );

            var adjSalesPricePerKg = adjSalesPriceTotal / totalWeight;
            adjSalesPricePerKgInputF.val(
                adjSalesPricePerKg.toFixed(4)
            );

            if (!isNaN(parseFloat(exRateInputF.val()))) {
                var totalPerUnitInNativeC = Number(totalPerUnit.val()) / Number(exRateInputF.val());
                var percentageAfterAdj = (((Number(adjSalesPricePerUnit.val()) - totalPerUnitInNativeC) / totalPerUnitInNativeC) * 100).toFixed(2);
                if (Number(percentageAfterAdj) < 15.00 && (Number($('#CorruCosting_CorruCostingId').val()) === 0 || $('#CorruCosting_CorruCostingId').val() === '') && @(User.IsInRole(Costing_Formula___KSPA.Utility.Helper.Admin) ? "false" : "true")) {
                    var adjSalesPricePerUnit_Val = (Math.trunc(115 * totalPerUnitInNativeC * 10000 / 100) / 10000).toString();
                    $('#saveBtnErrorSpan').show();
                    $('#submitButton').prop("disabled", true);
                    // iziToast.warning({
                    //     title: 'Warinig',
                    //     message: 'Profit percentage is less than 15%. Please increase the unit price!',
                    //     position: 'topRight',
                    //     timeout: 15000
                    // });
                } else {
                    // if (Number(percentageAfterAdj) < 0.00 && (Number($('#CorruCosting_CorruCostingId').val()) === 0 || $('#CorruCosting_CorruCostingId').val() === '')) {
                        //var adjSalesPricePerUnit_Val = (Math.trunc(110 * totalPerUnitInNativeC * 10000 / 100) / 10000).toString();
                        //$('#saveBtnErrorSpan').show();
                        //$('#submitButton').prop("disabled", true);
                    //     iziToast.warning({
                    //         title: 'Warinig',
                    //         message: 'Profit percentage is less than 0%. Please increase the unit price!',
                    //         position: 'topRight',
                    //         timeout: 1500
                    //     });
                    // }
                    $('#saveBtnErrorSpan').hide();
                    $('#submitButton').prop("disabled", false);
                }
                $('#adjProfitPercentPerUnit').val(
                    percentageAfterAdj + "%"
                );
                $('#adjProfitPercentTotal').val(
                    percentageAfterAdj + "%"
                );
                $('#adjProfitPercentPerKg').val(
                    percentageAfterAdj + "%"
                );

                $('#adjSalesPriceLkrPerUnit').val(
                    (adjSalesPricePerUnit.val() * exRateInputF.val()).toFixed(4)
                );
                $('#adjSalesPriceLkrTotal').val(
                    (adjSalesPriceTotalInputF.val() * exRateInputF.val()).toFixed(4)
                );
                $('#adjSalesPriceLkrPerKg').val(
                    (adjSalesPricePerKgInputF.val() * exRateInputF.val()).toFixed(4)
                );
            } else {
                $('#adjProfitPercentPerUnit').val("");
                $('#adjProfitPercentTotal').val("");
                $('#adjProfitPercentPerKg').val("");

                $('#adjSalesPriceLkrPerUnit').val("");
                $('#adjSalesPriceLkrTotal').val("");
                $('#adjSalesPriceLkrPerKg').val("");
            }

        }

